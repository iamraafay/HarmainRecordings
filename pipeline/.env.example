# Optional. Without it, `catalog` falls back to the channel RSS feed (15 most recent uploads).
# Create at https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> API key.
YOUTUBE_API_KEY=

# Required for `transcribe` and `sync`. Without it, use `npm run import` with output
# pasted from the Gemini app.
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
