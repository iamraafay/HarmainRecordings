    {
      "t0": 147,
      "t1": 153,
      "arabic": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"
    },
    {
      "t0": 154,
      "t1": 162,
      "arabic": "يَا أَيُّهَا الْإِنسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ"
    },
    {
      "t0": 163,
      "t1": 169,
      "arabic": "الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"
