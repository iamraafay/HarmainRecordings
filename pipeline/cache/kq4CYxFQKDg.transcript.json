{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 70,
      "t1": 74,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 75,
      "t1": 77,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 78,
      "t1": 82,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 83,
      "t1": 86,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 88,
      "t1": 92,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 93,
      "t1": 109,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 115,
      "t1": 118,
      "arabic": "قد أفلح المؤمنون"
    },
    {
      "t0": 119,
      "t1": 124,
      "arabic": "الذين هم في صلاتهم خاشعون"
    },
    {
      "t0": 124,
      "t1": 128,
      "arabic": "والذين هم عن اللغو معرضون"
    },
    {
      "t0": 129,
      "t1": 134,
      "arabic": "والذين هم للزكاة فاعلون"
    },
    {
      "t0": 135,
      "t1": 139,
      "arabic": "والذين هم لفروجهم حافظون"
    },
    {
      "t0": 140,
      "t1": 149,
      "arabic": "إلا على أزواجهم أو ما ملكت أيمانهم فإنهم غير ملومين"
    },
    {
      "t0": 150,
      "t1": 160,
      "arabic": "فمن ابتغى وراء ذلك فأولئك هم العادون"
    },
    {
      "t0": 161,
      "t1": 167,
      "arabic": "والذين هم لأماناتهم وعهدهم راعون"
    },
    {
      "t0": 168,
      "t1": 174,
      "arabic": "والذين هم على صلواتهم يحافظون"
    },
    {
      "t0": 174,
      "t1": 181,
      "arabic": "أولئك هم الوارثون"
    },
    {
      "t0": 182,
      "t1": 188,
      "arabic": "الذين يرثون الفردوس هم فيها خالدون"
    },
    {
      "t0": 189,
      "t1": 197,
      "arabic": "ولقد خلقنا الإنسان من سلالة من طين"
    },
    {
      "t0": 197,
      "t1": 203,
      "arabic": "ثم جعلناه نطفة في قرار مكين"
    },
    {
      "t0": 204,
      "t1": 233,
      "arabic": "ثم خلقنا النطفة علقة فخلقنا العلقة مضغة فخلقنا المضغة عظاما فكسونا العظام لحما ثم أنشأناه خلقا آخر فتبارك الله أحسن الخالقين"
    },
    {
      "t0": 234,
      "t1": 243,
      "arabic": "ثم إنكم بعد ذلك لميتون"
    },
    {
      "t0": 244,
      "t1": 253,
      "arabic": "ثم إنكم يوم القيامة تبعثون"
    },
    {
      "t0": 335,
      "t1": 339,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 340,
      "t1": 344,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 345,
      "t1": 347,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 348,
      "t1": 353,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 354,
      "t1": 358,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 359,
      "t1": 373,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 380,
      "t1": 390,
      "arabic": "ولقد خلقنا فوقكم سبع طرائق وما كنا عن الخلق غافلين"
    },
    {
      "t0": 391,
      "t1": 408,
      "arabic": "وأنزلنا من السماء ماء بقدر فأسكناه في الأرض وإنا على ذهاب به لقادرون"
    },
    {
      "t0": 408,
      "t1": 426,
      "arabic": "فأنشأنا لكم به جنات من نخيل وأعناب لكم فيها فواكه كثيرة ومنها تأكلون"
    },
    {
      "t0": 426,
      "t1": 449,
      "arabic": "وشجرة تخرج من طور سيناء تنبت بالدهن وصبغ للآكلين"
    },
    {
      "t0": 450,
      "t1": 465,
      "arabic": "وإن لكم في الأنعام لعبرة نسقيكم مما في بطونها ولكم فيها منافع كثيرة ومنها تأكلون"
    },
    {
      "t0": 466,
      "t1": 473,
      "arabic": "وعليها وعلى الفلك تحملون"
    }
  ],
  "windows": 2
}
