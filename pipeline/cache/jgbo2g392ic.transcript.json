      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 86,
      "t1": 88,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 88,
      "t1": 91,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 91,
      "t1": 97,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 97,
      "t1": 104,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 104,
      "t1": 114,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 120,
      "t1": 125,
      "arabic": "والتين والزيتون وطور سينين"
    },
    {
      "t0": 125,
      "t1": 128,
      "arabic": "وهذا البلد الأمين"
    },
    {
      "t0": 129,
      "t1": 136,
      "arabic": "لقد خلقنا الإنسان في أحسن تقويم"
    },
    {
      "t0": 136,
      "t1": 142,
      "arabic": "ثم رددناه أسفل سافلين"
    },
    {
      "t0": 142,
      "t1": 150,
      "arabic": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون"
    },
    {
      "t0": 151,
      "t1": 156,
      "arabic": "فما يكذبك بعد بالدين"
    },
    {
      "t0": 156,
      "t1": 162,
      "arabic": "أليس الله بأحكم الحاكمين"
    },
    {
      "t0": 229,
      "t1": 234,
      "arabic": "الحمد لله رب العالمين"
    },
    {
