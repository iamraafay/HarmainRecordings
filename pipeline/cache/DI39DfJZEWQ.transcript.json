    },
    {
      "t0": 88,
      "t1": 94,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 95,
      "t1": 100,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 101,
      "t1": 120,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 127,
      "t1": 157,
      "arabic": "إن الذين قالوا ربنا الله ثم استقاموا تتنزل عليهم الملائكة ألا تخافوا ولا تحزنوا وأبشروا بالجنة التي كنتم توعدون"
    },
    {
      "t0": 158,
      "t1": 167,
      "arabic": "نحن أولياؤكم في الحياة الدنيا وفي الآخرة"
    },
    {
      "t0": 168,
      "t1": 179,
      "arabic": "ولكم فيها ما تشتهي أنفسكم ولكم فيها ما تدعون"
    },
    {
      "t0": 180,
      "t1": 187,
      "arabic": "نزلا من غفور رحيم"
    },
    {
      "t0": 188,
      "t1": 208,
      "arabic": "ومن أحسن قولا ممن دعا إلى الله وعمل صالحا وقال إنني من المسلمين"
    },
    {
      "t0": 285,
      "t1": 290,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 290,
