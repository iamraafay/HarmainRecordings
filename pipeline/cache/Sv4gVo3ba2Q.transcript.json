  "segments": [
    {
      "t0": 82,
      "t1": 86,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 87,
      "t1": 90,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 91,
      "t1": 94,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 95,
      "t1": 101,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 102,
      "t1": 107,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 108,
      "t1": 113,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 114,
      "t1": 128,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 134,
      "t1": 141,
      "arabic": "إن يوم الفصل كان ميقاتا"
    },
    {
      "t0": 142,
      "t1": 149,
      "arabic": "يوم ينفخ في الصور فتأتون أفواجا"
    },
    {
      "t0": 150,
      "t1": 158,
      "arabic": "وفتحت السماء فكانت أبوابا"
    },
    {
      "t0": 159,
      "t1": 165,
      "arabic": "وسيرت الجبال فكانت سرابا"
    },
    {
      "t0": 166,
      "t1": 175,
      "arabic": "إن جهنم كانت مرصادا"
    },
    {
      "t0": 176,
      "t1": 179,
      "arabic": "للطاغين مآبا"
    },
    {
      "t0": 180,
      "t1": 188,
      "arabic": "لابثين فيها أحقابا"
    },
    {
      "t0": 189,
      "t1": 197,
      "arabic": "لا يذوقون فيها بردا ولا شرابا"
    },
    {
      "t0": 198,
      "t1": 204,
      "arabic": "إلا حميما وغساقا"
    },
    {
      "t0": 205,
      "t1": 211,
      "arabic": "جزاء وفاقا"
    },
    {
      "t0": 212,
      "t1": 218,
      "arabic": "إنهم كانوا لا يرجون حسابا"
    },
    {
      "t0": 219,
      "t1": 225,
      "arabic": "وكذبوا بآياتنا كذابا"
    },
    {
      "t0": 226,
      "t1": 232,
      "arabic": "وكل شيء أحصيناه كتابا"
    },
    {
      "t0": 233,
      "t1": 242,
      "arabic": "فذوقوا فلن نزيدكم إلا عذابا"
    },
    {
      "t0": 322,
      "t1": 326,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 327,
      "t1": 330,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 331,
      "t1": 334,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 335,
      "t1": 341,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 342,
      "t1": 346,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 347,
      "t1": 352,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 353,
      "t1": 367,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 372,
      "t1": 377,
      "arabic": "إن للمتقين مفازا"
    },
    {
      "t0": 378,
      "t1": 385,
      "arabic": "حدائق وأعنابا"
    },
    {
      "t0": 386,
      "t1": 390,
      "arabic": "وكواعب أترابا"
    },
    {
      "t0": 391,
      "t1": 395,
      "arabic": "وكأسا دهاقا"
    },
    {
      "t0": 396,
      "t1": 403,
      "arabic": "لا يسمعون فيها لغوا ولا كذابا"
    },
    {
      "t0": 404,
      "t1": 415,
      "arabic": "جزاء من ربك عطاء حسابا"
    },
    {
      "t0": 415,
      "t1": 430,
      "arabic": "رب السماوات والأرض وما بينهما الرحمن لا يملكون منه خطابا"
    },
    {
      "t0": 431,
      "t1": 453,
      "arabic": "يوم يقوم الروح والملائكة صفا لا يتكلمون إلا من أذن له الرحمن وقال صوابا"
    },
    {
      "t0": 453,
      "t1": 468,
      "arabic": "ذلك اليوم الحق فمن شاء اتخذ إلى ربه مآبا"
    },
    {
      "t0": 469,
      "t1": 501,
      "arabic": "إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
    }
