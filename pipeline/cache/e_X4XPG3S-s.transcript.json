    },
    {
      "t0": 133,
      "t1": 136,
      "arabic": "إِنَّ إِلَٰهَكُمْ لَوَاحِدٌ"
    },
    {
      "t0": 136,
      "t1": 143,
      "arabic": "رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ"
    },
    {
      "t0": 143,
      "t1": 151,
      "arabic": "إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ"
    },
    {
      "t0": 151,
      "t1": 157,
      "arabic": "وَحِفْظًا مِنْ كُلِّ شَيْطَانٍ مَارِدٍ"
    },
    {
      "t0": 158,
      "t1": 167,
      "arabic": "لَا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَىٰ وَيُقْذَفُونَ مِنْ كُلِّ جَانِبٍ"
    },
    {
      "t0": 167,
      "t1": 173,
      "arabic": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ"
    },
    {
      "t0": 173,
      "t1": 181,
      "arabic": "إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ"
    },
    {
      "t0": 181,
      "t1": 193,
      "arabic": "فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَمْ مَنْ خَلَقْنَا ۚ إِنَّا خَلَقْنَاهُمْ مِنْ طِينٍ لَازِبٍ"
    },
    {
      "t0": 193,
      "t1": 197,
      "arabic": "بَلْ عَجِبْتَ وَيَسْخَرُونَ"
    },
    {
      "t0": 197,
      "t1": 200,
      "arabic": "وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ"
    },
    {
      "t0": 200,
      "t1": 206,
      "arabic": "وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ"
    },
    {
      "t0": 206,
      "t1": 213,
      "arabic": "وَقَالُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُبِينٌ"
    },
    {
      "t0": 213,
      "t1": 228,
      "arabic": "أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ ۞ أَوَآبَاؤُنَا الْأَوَّلُونَ"
    },
    {
