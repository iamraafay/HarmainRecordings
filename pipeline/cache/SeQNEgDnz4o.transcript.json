{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 91,
      "t1": 96,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 97,
      "t1": 102,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 102,
      "t1": 107,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 107,
      "t1": 114,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 114,
      "t1": 119,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 119,
      "t1": 134,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 152,
      "t1": 156,
      "arabic": "لا أقسم بهذا البلد"
    },
    {
      "t0": 157,
      "t1": 163,
      "arabic": "وأنت حل بهذا البلد"
    },
    {
      "t0": 164,
      "t1": 167,
      "arabic": "ووالد وما ولد"
    },
    {
      "t0": 167,
      "t1": 173,
      "arabic": "لقد خلقنا الإنسان في كبد"
    },
    {
      "t0": 173,
      "t1": 178,
      "arabic": "أيحسب أن لن يقدر عليه أحد"
    },
    {
      "t0": 179,
      "t1": 183,
      "arabic": "يقول أهلكت مالا لبدا"
    },
    {
      "t0": 183,
      "t1": 187,
      "arabic": "أيحسب أن لم يره أحد"
    },
    {
      "t0": 187,
      "t1": 191,
      "arabic": "ألم نجعل له عينين"
    },
    {
      "t0": 192,
      "t1": 195,
      "arabic": "ولسانا وشفتين"
    },
    {
      "t0": 196,
      "t1": 200,
      "arabic": "وهديناه النجدين"
    },
    {
      "t0": 201,
      "t1": 204,
      "arabic": "فلا اقتحم العقبة"
    },
    {
      "t0": 204,
      "t1": 207,
      "arabic": "وما أدراك ما العقبة"
    },
    {
      "t0": 207,
      "t1": 209,
      "arabic": "فك رقبة"
    },
    {
      "t0": 210,
      "t1": 215,
      "arabic": "أو إطعام في يوم ذي مسغبة"
    },
    {
      "t0": 215,
      "t1": 219,
      "arabic": "يتيما ذا مقربة"
    },
    {
      "t0": 219,
      "t1": 223,
      "arabic": "أو مسكينا ذا متربة"
    },
    {
      "t0": 224,
      "t1": 233,
      "arabic": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"
    },
    {
      "t0": 233,
      "t1": 238,
      "arabic": "أولئك أصحاب الميمنة"
    },
    {
      "t0": 238,
      "t1": 245,
      "arabic": "والذين كفروا بآياتنا هم أصحاب المشأمة"
    },
    {
      "t0": 245,
      "t1": 249,
      "arabic": "عليهم نار مؤصدة"
    },
    {
      "t0": 334,
      "t1": 340,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 340,
      "t1": 344,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 345,
      "t1": 348,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 349,
      "t1": 355,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 356,
      "t1": 361,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 361,
      "t1": 377,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 396,
      "t1": 401,
      "arabic": "إذا زلزلت الأرض زلزالها"
    },
    {
      "t0": 401,
      "t1": 405,
      "arabic": "وأخرجت الأرض أثقالها"
    },
    {
      "t0": 405,
      "t1": 410,
      "arabic": "وقال الإنسان ما لها"
    },
    {
      "t0": 411,
      "t1": 415,
      "arabic": "يومئذ تحدث أخبارها"
    },
    {
      "t0": 415,
      "t1": 420,
      "arabic": "بأن ربك أوحى لها"
    },
    {
      "t0": 420,
      "t1": 428,
      "arabic": "يومئذ يصدر الناس أشتاتا ليروا أعمالهم"
    },
    {
      "t0": 428,
      "t1": 435,
      "arabic": "فمن يعمل مثقال ذرة خيرا يره"
    },
    {
      "t0": 435,
      "t1": 442,
      "arabic": "ومن يعمل مثقال ذرة شرا يره"
    }
  ],
  "windows": 2
}
