    },
    {
      "t0": 337,
      "t1": 356,
      "arabic": "ولا تستوي الحسنة ولا السيئة ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم"
    },
    {
      "t0": 357,
      "t1": 368,
      "arabic": "وما يلقاها إلا الذين صبروا وما يلقاها إلا ذو حظ عظيم"
    },
