      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 88,
      "t1": 96,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 96,
      "t1": 106,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 116,
      "t1": 120,
      "arabic": "ويل لكل همزة لمزة"
    },
    {
      "t0": 120,
      "t1": 124,
      "arabic": "الذي جمع مالا وعدده"
    },
    {
      "t0": 124,
      "t1": 130,
      "arabic": "يحسب أن ماله أخلده"
    },
    {
      "t0": 130,
