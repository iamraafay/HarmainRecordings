      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 85,
      "t1": 93,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 93,
      "t1": 101,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 101,
      "t1": 114,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 119,
      "t1": 133,
      "arabic": "إن الذين قالوا ربنا الله ثم استقاموا تتنزل عليهم الملائكة"
    },
    {
      "t0": 134,
      "t1": 158,
      "arabic": "تتنزل عليهم الملائكة ألا تخافوا ولا تحزنوا وأبشروا بالجنة التي كنتم توعدون"
    },
    {
      "t0": 158,
      "t1": 167,
      "arabic": "نحن أولياؤكم في الحياة الدنيا وفي الآخرة"
    },
    {
      "t0": 167,
      "t1": 179,
      "arabic": "ولكم فيها ما تشتهي أنفسكم ولكم فيها ما تدعون"
    },
    {
      "t0": 179,
      "t1": 187,
      "arabic": "نزلا من غفور رحيم"
    },
    {
      "t0": 253,
