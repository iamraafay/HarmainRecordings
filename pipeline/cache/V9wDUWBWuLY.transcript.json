  "segments": [
    {
      "t0": 65,
      "t1": 69,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 69,
      "t1": 72,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 72,
      "t1": 76,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 76,
      "t1": 81,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 81,
      "t1": 85,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 85,
      "t1": 91,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 91,
      "t1": 100,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 108,
      "t1": 137,
      "arabic": "إن الذين يجادلون في آيات الله بغير سلطان أتاهم إن في صدورهم إلا كبر ما هم ببالغيه فاستعذ بالله إنه هو السميع البصير"
    },
    {
      "t0": 137,
      "t1": 149,
      "arabic": "لخلق السماوات والأرض أكبر من خلق الناس ولكن أكثر الناس لا يعلمون"
    },
    {
      "t0": 150,
      "t1": 166,
      "arabic": "وما يستوي الأعمى والبصير والذين آمنوا وعملوا الصالحات ولا المسيء قليلا ما تتذكرون"
    },
    {
      "t0": 167,
      "t1": 178,
      "arabic": "إن الساعة لآتية لا ريب فيها ولكن أكثر الناس لا يؤمنون"
    },
    {
      "t0": 178,
      "t1": 202,
      "arabic": "وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين"
    },
    {
      "t0": 203,
      "t1": 223,
      "arabic": "الله الذي جعل لكم الليل لتسكنوا فيه والنهار مبصرا إن الله لذو فضل على الناس ولكن أكثر الناس لا يشكرون"
    },
    {
      "t0": 224,
      "t1": 244,
      "arabic": "ذلكم الله ربكم خالق كل شيء لا إله إلا هو فأنى تؤفكون"
    },
    {
      "t0": 245,
      "t1": 257,
      "arabic": "كذلك يؤفك الذين كانوا بآيات الله يجحدون"
    },
    {
      "t0": 337,
      "t1": 340,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 340,
      "t1": 343,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 343,
      "t1": 347,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 347,
      "t1": 352,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 352,
      "t1": 355,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 355,
      "t1": 360,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 360,
      "t1": 370,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 375,
      "t1": 407,
      "arabic": "الله الذي جعل لكم الأرض قرارا والسماء بناء وصوركم فأحسن صوركم ورزقكم من الطيبات ذلكم الله ربكم فتبارك الله رب العالمين"
    },
    {
      "t0": 408,
      "t1": 438,
      "arabic": "هو الحي لا إله إلا هو فادعوه مخلصين له الدين الحمد لله رب العالمين"
    }
  ],
