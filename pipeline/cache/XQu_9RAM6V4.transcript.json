{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 77,
      "t1": 82,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 83,
      "t1": 86,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 86,
      "t1": 90,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 90,
      "t1": 95,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 95,
      "t1": 100,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 100,
      "t1": 115,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 123,
      "t1": 131,
      "arabic": "إن الذين فرقوا دينهم وكانوا شيعا لست منهم في شيء"
    },
    {
      "t0": 132,
      "t1": 144,
      "arabic": "إنما أمرهم إلى الله ثم ينبئهم بما كانوا يفعلون"
    },
    {
      "t0": 145,
      "t1": 154,
      "arabic": "من جاء بالحسنة فله عشر أمثالها"
    },
    {
      "t0": 154,
      "t1": 166,
      "arabic": "ومن جاء بالسيئة فلا يجزي إلا مثلها وهم لا يظلمون"
    },
    {
      "t0": 167,
      "t1": 192,
      "arabic": "قل إنني هداني ربي إلى صراط مستقيم دينا قيما ملة إبراهيم حنيفا وما كان من المشركين"
    },
    {
      "t0": 193,
      "t1": 204,
      "arabic": "قل إن صلاتي ونسكي ومحياي ومماتي لله رب العالمين"
    },
    {
      "t0": 204,
      "t1": 212,
      "arabic": "لا شريك له وبذلك أمرت وأنا أول المسلمين"
    },
    {
      "t0": 213,
      "t1": 221,
      "arabic": "قل أغير الله أبغي ربا وهو رب كل شيء"
    },
    {
      "t0": 221,
      "t1": 228,
      "arabic": "ولا تكسب كل نفس إلا عليها"
    },
    {
      "t0": 228,
      "t1": 235,
      "arabic": "ولا تزر وازرة وزر أخرى"
    },
    {
      "t0": 235,
      "t1": 247,
      "arabic": "ثم إلى ربكم مرجعكم فينبئكم بما كنتم فيه تختلفون"
    },
    {
      "t0": 248,
      "t1": 264,
      "arabic": "وهو الذي جعلكم خلائف الأرض ورفع بعضكم فوق بعض درجات ليبلوكم في ما آتاكم"
    },
    {
      "t0": 265,
      "t1": 279,
      "arabic": "إن ربك سريع العقاب وإنه لغفور رحيم"
    },
    {
      "t0": 364,
      "t1": 369,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 369,
      "t1": 373,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 373,
      "t1": 376,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 376,
      "t1": 381,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 382,
      "t1": 387,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 387,
      "t1": 404,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 410,
      "t1": 421,
      "arabic": "فإذا جاءت الصاخة"
    },
    {
      "t0": 421,
      "t1": 428,
      "arabic": "يوم يفر المرء من أخيه"
    },
    {
      "t0": 428,
      "t1": 435,
      "arabic": "وأمه وأبيه"
    },
    {
      "t0": 435,
      "t1": 442,
      "arabic": "وصاحبته وبنيه"
    },
    {
      "t0": 442,
      "t1": 455,
      "arabic": "لكل امرئ منهم يومئذ شأن يغنيه"
    },
    {
      "t0": 455,
      "t1": 463,
      "arabic": "وجوه يومئذ مسفرة"
    },
    {
      "t0": 464,
      "t1": 472,
      "arabic": "ضاحكة مستبشرة"
    },
    {
      "t0": 472,
      "t1": 481,
      "arabic": "ووجوه يومئذ عليها غبرة"
    },
    {
      "t0": 481,
      "t1": 488,
      "arabic": "ترهقها قترة"
    },
    {
      "t0": 489,
      "t1": 496,
      "arabic": "أولئك هم الكفرة الفجرة"
    }
  ],
