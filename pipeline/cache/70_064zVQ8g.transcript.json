    },
    {
      "t0": 92,
      "t1": 99,
      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ"
    },
    {
      "t0": 99,
      "t1": 111,
      "arabic": "غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 116,
      "t1": 121,
      "arabic": "إِذَا السَّمَاءُ انفَطَرَتْ"
    },
    {
      "t0": 121,
      "t1": 125,
      "arabic": "وَإِذَا الْكَوَاكِبُ انتَثَرَتْ"
    },
    {
      "t0": 125,
      "t1": 128,
      "arabic": "وَإِذَا الْبِحَارُ فُجِّرَتْ"
    },
    {
