      "t1": 128,
      "arabic": "وللآخرة خير لك من الأولى"
    },
    {
      "t0": 128,
      "t1": 133,
      "arabic": "ولسوف يعطيك ربك فترضى"
    },
    {
      "t0": 133,
      "t1": 138,
      "arabic": "ألم يجدك يتيما فآوى"
    },
    {
      "t0": 138,
      "t1": 145,
      "arabic": "ووجدك ضالا فهدي"
    },
    {
      "t0": 145,
      "t1": 151,
      "arabic": "ووجدك عائلا فأغنى"
    },
    {
      "t0": 151,
      "t1": 156,
      "arabic": "فأما اليتيم فلا تقهر"
