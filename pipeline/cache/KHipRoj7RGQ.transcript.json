    {
      "t0": 134,
      "t1": 144,
      "arabic": "غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 159,
      "t1": 164,
      "arabic": "لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ"
    },
    {
      "t0": 165,
      "t1": 173,
      "arabic": "وَإِن تُبْدُوا مَا فِي أَنفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُم بِهِ اللَّهُ"
    },
    {
      "t0": 174,
      "t1": 182,
      "arabic": "فَيَغْفِرُ لِمَن يَشَاءُ وَيُعَذِّبُ مَن يَشَاءُ"
    },
    {
      "t0": 183,
      "t1": 189,
      "arabic": "وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
    },
    {
      "t0": 190,
      "t1": 198,
      "arabic": "آمَنَ الرَّسُولُ بِمَا أُنزِلَ إِلَيْهِ مِن رَّبِّهِ وَالْمُؤْمِنُونَ"
    },
    {
      "t0": 199,
      "t1": 212,
      "arabic": "كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّن رُسُلِهِ"
    },
    {
      "t0": 213,
      "t1": 221,
      "arabic": "وَقَالُوا سَمِعْنَا وَأَطَعْنَا غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ"
    },
    {
      "t0": 222,
      "t1": 231,
      "arabic": "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ"
    },
    {
      "t0": 232,
      "t1": 239,
      "arabic": "رَبَّنَا لَا تُؤَاخِذْنَا إِن نَّسِينَا أَوْ أَخْطَأْنَا"
    },
    {
      "t0": 240,
      "t1": 249,
