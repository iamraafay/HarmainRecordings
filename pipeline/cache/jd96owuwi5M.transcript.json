    },
    {
      "t0": 168,
      "t1": 186,
      "arabic": "ولا تكونوا كالذين نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون"
    },
    {
      "t0": 188,
      "t1": 206,
      "arabic": "لا يستوي أصحاب النار وأصحاب الجنة أصحاب الجنة هم الفائزون"
    },
    {
      "t0": 207,
      "t1": 227,
      "arabic": "لو أنزلنا هذا القرآن على جبل لرأيته خاشعا متصدعا من خشية الله"
    },
    {
