  "segments": [
    {
      "t0": 59,
      "t1": 63,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 63,
      "t1": 67,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 67,
      "t1": 71,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 71,
      "t1": 76,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 76,
      "t1": 80,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 80,
      "t1": 83,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 83,
      "t1": 94,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 99,
      "t1": 105,
      "arabic": "والسماء ذات البروج"
    },
    {
      "t0": 105,
      "t1": 110,
      "arabic": "واليوم الموعود"
    },
    {
      "t0": 110,
      "t1": 115,
      "arabic": "وشاهد ومشهود"
    },
    {
      "t0": 115,
      "t1": 120,
      "arabic": "قتل أصحاب الأخدود"
    },
    {
      "t0": 120,
      "t1": 124,
      "arabic": "النار ذات الوقود"
    },
    {
      "t0": 124,
      "t1": 128,
      "arabic": "إذ هم عليها قعود"
    },
    {
      "t0": 128,
      "t1": 135,
      "arabic": "وهم على ما يفعلون بالمؤمنين شهود"
    },
    {
      "t0": 135,
      "t1": 145,
      "arabic": "وما نقموا منهم إلا أن يؤمنوا بالله العزيز الحميد"
    },
    {
      "t0": 145,
      "t1": 157,
      "arabic": "الذي له ملك السماوات والأرض والله على كل شيء شهيد"
    },
    {
      "t0": 158,
      "t1": 179,
      "arabic": "إن الذين فتنوا المؤمنين والمؤمنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق"
    },
    {
      "t0": 180,
      "t1": 205,
      "arabic": "إن الذين آمنوا وعملوا الصالحات لهم جنات تجري من تحتها الأنهار ذلك الفوز الكبير"
    },
    {
      "t0": 262,
      "t1": 266,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 266,
      "t1": 271,
      "arabic": "الرحمن الرحيم مالك يوم الدين"
    },
    {
      "t0": 271,
      "t1": 277,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 277,
      "t1": 282,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 282,
      "t1": 297,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 301,
      "t1": 307,
      "arabic": "إن بطش ربك لشديد"
    },
    {
      "t0": 307,
      "t1": 313,
      "arabic": "إنه هو يبدئ ويعيد"
    },
    {
      "t0": 313,
      "t1": 320,
      "arabic": "وهو الغفور الودود ذو العرش المجيد"
    },
    {
      "t0": 320,
      "t1": 325,
      "arabic": "فعال لما يريد"
    },
    {
      "t0": 325,
      "t1": 330,
      "arabic": "هل أتاك حديث الجنود"
    },
    {
      "t0": 330,
      "t1": 333,
      "arabic": "فرعون وثمود"
    },
    {
      "t0": 333,
      "t1": 339,
      "arabic": "بل الذين كفروا في تكذيب"
    },
    {
      "t0": 339,
      "t1": 349,
      "arabic": "والله من ورائهم محيط"
    },
    {
      "t0": 349,
      "t1": 355,
      "arabic": "بل هو قرآن مجيد"
    },
    {
      "t0": 355,
      "t1": 365,
      "arabic": "في لوح محفوظ"
    }
  ],
