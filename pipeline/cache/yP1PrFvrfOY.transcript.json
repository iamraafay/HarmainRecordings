  "segments": [
    {
      "t0": 73,
      "t1": 78,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 78,
      "t1": 81,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 81,
      "t1": 85,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 86,
      "t1": 91,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 92,
      "t1": 96,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 96,
      "t1": 112,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 115,
      "t1": 118,
      "arabic": "والمرسلات عرفا"
    },
    {
      "t0": 118,
      "t1": 121,
      "arabic": "فالعاصفات عصفا"
    },
    {
      "t0": 121,
      "t1": 125,
      "arabic": "والناشرات نشرا"
    },
    {
      "t0": 125,
      "t1": 128,
      "arabic": "فالفارقات فرقا"
    },
    {
      "t0": 128,
      "t1": 131,
      "arabic": "فالملقيات ذكرا"
    },
    {
      "t0": 131,
      "t1": 133,
      "arabic": "عذرا أو نذرا"
    },
    {
      "t0": 133,
      "t1": 138,
      "arabic": "إنما توعدون لواقع"
    },
    {
      "t0": 138,
      "t1": 141,
      "arabic": "فإذا النجوم طمست"
    },
    {
      "t0": 141,
      "t1": 146,
      "arabic": "وإذا السماء فرجت"
    },
    {
      "t0": 146,
      "t1": 149,
      "arabic": "وإذا الجبال نسفت"
    },
    {
      "t0": 149,
      "t1": 152,
      "arabic": "وإذا الرسل أقتت"
    },
    {
      "t0": 152,
      "t1": 156,
      "arabic": "لأي يوم أجلت"
    },
    {
      "t0": 156,
      "t1": 157,
      "arabic": "ليوم الفصل"
    },
    {
      "t0": 157,
      "t1": 161,
      "arabic": "وما أدراك ما يوم الفصل"
    },
    {
      "t0": 161,
      "t1": 166,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 166,
      "t1": 169,
      "arabic": "ألم نهلك الأولين"
    },
    {
      "t0": 169,
      "t1": 173,
      "arabic": "ثم نتبعهم الآخرين"
    },
    {
      "t0": 173,
      "t1": 177,
      "arabic": "كذلك نفعل بالمجرمين"
    },
    {
      "t0": 177,
      "t1": 182,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 182,
      "t1": 189,
      "arabic": "ألم نخلقكم من ماء مهين"
    },
    {
      "t0": 189,
      "t1": 195,
      "arabic": "فجعلناه في قرار مكين"
    },
    {
      "t0": 195,
      "t1": 198,
      "arabic": "إلى قدر معلوم"
    },
    {
      "t0": 198,
      "t1": 202,
      "arabic": "فقدرنا فنعم القادرون"
    },
    {
      "t0": 202,
      "t1": 207,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 208,
      "t1": 217,
      "arabic": "ألم نجعل الأرض كفاتا أحياء وأمواتا"
    },
    {
      "t0": 218,
      "t1": 233,
      "arabic": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"
    },
    {
      "t0": 233,
      "t1": 238,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 238,
      "t1": 247,
      "arabic": "انطلقوا إلى ما كنتم به تكذبون"
    },
    {
      "t0": 247,
      "t1": 253,
      "arabic": "انطلقوا إلى ظل ذي ثلاث شعب"
    },
    {
      "t0": 254,
      "t1": 258,
      "arabic": "لا ظليل ولا يغني من اللهب"
    },
    {
      "t0": 258,
      "t1": 264,
      "arabic": "إنها ترمي بشرر كالقصر"
    },
    {
      "t0": 264,
      "t1": 270,
      "arabic": "كأنه جمالت صفر"
    },
    {
      "t0": 270,
      "t1": 275,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 275,
      "t1": 281,
      "arabic": "هذا يوم لا ينطقون"
    },
    {
      "t0": 281,
      "t1": 285,
      "arabic": "ولا يؤذن لهم فيعتذرون"
    },
    {
      "t0": 285,
      "t1": 291,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
      "t0": 291,
      "t1": 298,
      "arabic": "هذا يوم الفصل جمعناكم والأولين"
    },
    {
      "t0": 298,
      "t1": 304,
      "arabic": "فإن كان لكم كيد فكيدون"
    },
    {
      "t0": 305,
      "t1": 315,
      "arabic": "ويل يومئذ للمكذبين"
    },
    {
