      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 79,
      "t1": 82,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 83,
      "t1": 88,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 89,
      "t1": 93,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 94,
      "t1": 98,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 99,
      "t1": 109,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 114,
      "t1": 119,
      "arabic": "والسماء والطارق"
    },
    {
      "t0": 120,
      "t1": 123,
      "arabic": "وما أدراك ما الطارق"
    },
    {
      "t0": 123,
      "t1": 127,
      "arabic": "النجم الثاقب"
    },
    {
      "t0": 128,
      "t1": 134,
      "arabic": "إن كل نفس لما عليها حافظ"
    },
    {
      "t0": 135,
      "t1": 142,
      "arabic": "فلينظر الإنسان مم خلق"
    },
    {
      "t0": 142,
      "t1": 150,
      "arabic": "خلق من ماء دافق"
    },
    {
      "t0": 151,
      "t1": 157,
      "arabic": "يخرج من بين الصلب والترائب"
    },
    {
      "t0": 158,
      "t1": 164,
      "arabic": "إنه على رجعه لقادر"
    },
    {
      "t0": 164,
      "t1": 169,
      "arabic": "يوم تبلى السرائر"
    },
    {
      "t0": 169,
      "t1": 177,
      "arabic": "فما له من قوة ولا ناصر"
    },
    {
      "t0": 178,
      "t1": 182,
      "arabic": "والسماء ذات الرجع"
    },
    {
      "t0": 183,
      "t1": 186,
      "arabic": "والأرض ذات الصدع"
    },
    {
      "t0": 187,
      "t1": 193,
      "arabic": "إنه لقول فصل"
    },
    {
      "t0": 193,
      "t1": 197,
      "arabic": "وما هو بالهزل"
    },
    {
      "t0": 197,
      "t1": 202,
      "arabic": "إنهم يكيدون كيدا"
    },
    {
      "t0": 202,
      "t1": 206,
      "arabic": "وأكيد كيدا"
    },
    {
      "t0": 206,
      "t1": 213,
      "arabic": "فمهل الكافرين أمهلهم رويدا"
