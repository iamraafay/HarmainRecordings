      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 108,
      "t1": 123,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 130,
      "t1": 142,
      "arabic": "ولقد آتينا موسى الهدى وأورثنا بني إسرائيل الكتاب"
    },
    {
      "t0": 143,
      "t1": 149,
      "arabic": "هدى وذكرى لأولي الألباب"
    },
    {
      "t0": 150,
      "t1": 170,
      "arabic": "فاصبر إن وعد الله حق واستغفر لذنبك وسبح بحمد ربك بالعشي والإبكار"
    },
    {
      "t0": 171,
      "t1": 188,
      "arabic": "إن الذين يجادلون في آيات الله بغير سلطان أتاهم إن في صدورهم إلا كبر ما هم ببالغيه"
    },
    {
      "t0": 189,
      "t1": 198,
      "arabic": "فاستعذ بالله إنه هو السميع البصير"
    },
    {
      "t0": 199,
      "t1": 218,
      "arabic": "لخلق السماوات والأرض أكبر من خلق الناس ولكن أكثر الناس لا يعلمون"
    },
