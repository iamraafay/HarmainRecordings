      "arabic": "الرَّحْمَٰنِ الرَّحِيمِ"
    },
    {
      "t0": 67,
      "t1": 69,
      "arabic": "مَالِكِ يَوْمِ الدِّينِ"
    },
    {
      "t0": 69,
      "t1": 73,
      "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
    },
    {
      "t0": 73,
      "t1": 77,
      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"
    },
    {
      "t0": 77,
      "t1": 87,
      "arabic": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 91,
      "t1": 95,
      "arabic": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"
    },
    {
      "t0": 95,
      "t1": 98,
      "arabic": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"
    },
    {
      "t0": 98,
      "t1": 102,
      "arabic": "أُولَٰئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"
    },
    {
      "t0": 102,
      "t1": 105,
      "arabic": "فَوَاكِهُ وَهُم مَُّكْرَمُونَ"
    },
    {
      "t0": 105,
      "t1": 107,
      "arabic": "فِي جَنَّاتِ النَّعِيمِ"
    },
    {
      "t0": 107,
      "t1": 110,
      "arabic": "عَلَىٰ سُرُرٍ مَُّتَقَابِلِينَ"
    },
    {
      "t0": 110,
      "t1": 115,
      "arabic": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍ"
    },
    {
      "t0": 115,
      "t1": 119,
      "arabic": "بَيْضَاءَ لَذَّةٍ لِّلشَّارِبِينَ"
    },
    {
      "t0": 119,
      "t1": 124,
      "arabic": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"
    },
    {
      "t0": 124,
      "t1": 128,
      "arabic": "وَعِندَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ"
    },
    {
      "t0": 128,
      "t1": 131,
      "arabic": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"
    },
    {
      "t0": 132,
      "t1": 137,
      "arabic": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ"
    },
    {
      "t0": 137,
      "t1": 142,
      "arabic": "قَالَ قَائِلٌ مِّنْهُمْ إِنِّي كَانَ لِي قَرِينٌ"
    },
    {
      "t0": 142,
      "t1": 146,
      "arabic": "يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ"
    },
    {
      "t0": 146,
      "t1": 157,
      "arabic": "أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ"
    },
    {
      "t0": 157,
      "t1": 160,
      "arabic": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"
    },
    {
      "t0": 161,
      "t1": 165,
      "arabic": "فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ"
    },
    {
      "t0": 165,
      "t1": 169,
      "arabic": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ"
    },
    {
      "t0": 169,
      "t1": 175,
      "arabic": "وَلَوْلَا نِعْمَةُ رَبِّي لَكُنتُ مِنَ الْمُحْضَرِينَ"
    },
    {
      "t0": 175,
      "t1": 180,
      "arabic": "إِنَّ هَٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ"
    },
    {
      "t0": 180,
      "t1": 184,
      "arabic": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ الْعَامِلُونَ"
    },
    {
      "t0": 185,
