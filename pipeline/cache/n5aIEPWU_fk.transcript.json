    },
    {
      "t0": 154,
      "t1": 162,
      "arabic": "في أي صورة ما شاء ركبك"
    },
    {
      "t0": 162,
      "t1": 167,
      "arabic": "كلا بل تكذبون بالدين"
    },
    {
