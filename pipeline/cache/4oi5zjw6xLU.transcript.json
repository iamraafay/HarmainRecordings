    {
      "t0": 1484,
      "t1": 1489,
      "arabic": "ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ"
    },
    {
      "t0": 1489,
      "t1": 1497,
      "arabic": "إِلاَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"
    },
    {
      "t0": 1497,
