  "segments": [
    {
      "t0": 64,
      "t1": 69,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 69,
      "t1": 73,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 73,
      "t1": 78,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 79,
      "t1": 85,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 85,
      "t1": 90,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 90,
      "t1": 103,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 103,
      "t1": 106,
      "arabic": "آمين"
    },
    {
      "t0": 108,
      "t1": 112,
      "arabic": "والليل إذا يغشى"
    },
    {
      "t0": 112,
      "t1": 116,
      "arabic": "والنهار إذا تجلى"
    },
    {
      "t0": 116,
      "t1": 121,
      "arabic": "وما خلق الذكر والأنثى"
    },
    {
      "t0": 121,
      "t1": 125,
      "arabic": "إن سعيكم لشتى"
    },
    {
      "t0": 125,
      "t1": 129,
      "arabic": "فأاما من أعطى واتقى"
    },
    {
      "t0": 129,
      "t1": 133,
      "arabic": "وصدق بالحسنى"
    },
    {
      "t0": 133,
      "t1": 136,
      "arabic": "فسنيسره لليسرى"
    },
    {
      "t0": 136,
      "t1": 141,
      "arabic": "وأما من بخل واستغنى"
    },
    {
      "t0": 141,
      "t1": 144,
      "arabic": "وكذب بالحسنى"
    },
    {
      "t0": 144,
      "t1": 147,
      "arabic": "فسنيسره للعسرى"
    },
    {
      "t0": 147,
      "t1": 153,
      "arabic": "وما يغني عنه ماله إذا تردى"
    },
    {
      "t0": 153,
      "t1": 157,
      "arabic": "إن علينا للهدى"
    },
    {
      "t0": 157,
      "t1": 162,
      "arabic": "وإن لنا للآخرة والأولى"
    },
    {
      "t0": 162,
      "t1": 168,
      "arabic": "فأنذرتكم نارا تلظى"
    },
    {
      "t0": 168,
      "t1": 171,
      "arabic": "لا يصلاها إلا الأشقى"
    },
    {
      "t0": 171,
      "t1": 175,
      "arabic": "الذي كذب وتولى"
    },
    {
      "t0": 175,
      "t1": 179,
      "arabic": "وسيجنبها الأتقى"
    },
    {
      "t0": 179,
      "t1": 183,
      "arabic": "الذي يؤتي ماله يتزكى"
    },
    {
      "t0": 183,
      "t1": 192,
      "arabic": "وما لأحد عنده من نعمة تجزى"
    },
    {
      "t0": 192,
      "t1": 198,
      "arabic": "إلا ابتغاء وجه ربه الأعلى"
    },
    {
      "t0": 198,
      "t1": 202,
      "arabic": "ولسوف يرضى"
    },
    {
      "t0": 270,
      "t1": 275,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 275,
      "t1": 278,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 278,
      "t1": 281,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 281,
      "t1": 286,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 287,
      "t1": 291,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 291,
      "t1": 304,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 304,
      "t1": 307,
      "arabic": "آمين"
    },
    {
      "t0": 308,
      "t1": 311,
      "arabic": "والتين والزيتون"
    },
    {
      "t0": 311,
      "t1": 314,
      "arabic": "وطور سينين"
    },
    {
      "t0": 314,
      "t1": 317,
      "arabic": "وهذا البلد الأمين"
    },
    {
      "t0": 317,
      "t1": 324,
      "arabic": "لقد خلقنا الإنسان في أحسن تقويم"
    },
    {
      "t0": 324,
      "t1": 329,
      "arabic": "ثم رددناه أسفل سافلين"
    },
    {
      "t0": 329,
      "t1": 337,
      "arabic": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون"
    },
    {
      "t0": 337,
      "t1": 342,
      "arabic": "فما يكذبك بعد بالدين"
    },
    {
      "t0": 342,
      "t1": 349,
      "arabic": "أليس الله بأحكم الحاكمين"
    },
    {
      "t0": 1224,
      "t1": 1229,
      "arabic": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
    },
    {
      "t0": 1229,
      "t1": 1233,
      "arabic": "الرَّحْمَٰنِ الرَّحِيمِ"
    },
    {
      "t0": 1233,
      "t1": 1239,
      "arabic": "مَالِكِ يَوْمِ الدِّينِ"
    },
    {
      "t0": 1239,
      "t1": 1245,
      "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
    },
    {
      "t0": 1245,
      "t1": 1263,
      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 1268,
      "t1": 1271,
      "arabic": "وَاللَّيْلِ إِذَا يَغْشَى"
    },
    {
      "t0": 1271,
      "t1": 1275,
      "arabic": "وَالنَّهَارِ إِذَا تَجَلَّى"
    },
    {
      "t0": 1275,
      "t1": 1281,
      "arabic": "وَمَا خَلَقَ الذَّكَرَ وَالأُنثَى"
    },
    {
      "t0": 1281,
      "t1": 1285,
      "arabic": "إِنَّ سَعْيَكُمْ لَشَتَّى"
    },
    {
      "t0": 1285,
      "t1": 1291,
      "arabic": "فَأَمَّا مَنْ أَعْطَى وَاتَّقَى"
    },
    {
      "t0": 1291,
      "t1": 1293,
      "arabic": "وَصَدَّقَ بِالْحُسْنَى"
    },
    {
      "t0": 1293,
      "t1": 1296,
      "arabic": "فَسَنُيَسِّرُهُ لِلْيُسْرَى"
    },
    {
      "t0": 1296,
      "t1": 1300,
      "arabic": "وَأَمَّا مَن بَخِلَ وَاسْتَغْنَى"
    },
    {
      "t0": 1300,
      "t1": 1304,
      "arabic": "وَكَذَّبَ بِالْحُسْنَى"
    },
    {
      "t0": 1304,
      "t1": 1307,
      "arabic": "فَسَنُيَسِّرُهُ لِلْعُسْرَى"
    },
    {
      "t0": 1307,
      "t1": 1312,
      "arabic": "وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّى"
    },
    {
      "t0": 1312,
      "t1": 1315,
      "arabic": "إِنَّ عَلَيْنَا لَلْهُدَى"
    },
    {
      "t0": 1315,
      "t1": 1320,
      "arabic": "وَإِنَّ لَنَا لَلآخِرَةَ وَالأُولَى"
    },
    {
      "t0": 1320,
      "t1": 1327,
      "arabic": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّى"
    },
    {
      "t0": 1327,
      "t1": 1332,
      "arabic": "لا يَصْلاهَا إِلاَّ الأَشْقَى"
    },
    {
      "t0": 1332,
      "t1": 1335,
      "arabic": "الَّذِي كَذَّبَ وَتَوَلَّى"
    },
    {
      "t0": 1335,
      "t1": 1339,
      "arabic": "وَسَيُجَنَّبُهَا الأَتْقَى"
    },
    {
      "t0": 1339,
      "t1": 1343,
      "arabic": "الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّى"
    },
    {
      "t0": 1343,
      "t1": 1351,
      "arabic": "وَمَا لأَحَدٍ عِندَهُ مِن نِّعْمَةٍ تُجْزَى"
    },
    {
      "t0": 1351,
      "t1": 1358,
      "arabic": "إِلاَّ ابْتِغَاء وَجْهِ رَبِّهِ الأَعْلَى"
    },
    {
      "t0": 1358,
      "t1": 1362,
      "arabic": "وَلَسَوْفَ يَرْضَى"
    },
    {
