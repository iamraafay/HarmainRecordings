      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 109,
      "t1": 115,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 116,
      "t1": 121,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 122,
      "t1": 138,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 147,
      "t1": 158,
      "arabic": "وما خلقنا السماء والأرض وما بينهما لاعبين"
    },
    {
      "t0": 159,
      "t1": 175,
      "arabic": "لو أردنا أن نتخذ لهوا لاتخذناه من لدنا إن كنا فاعلين"
    },
    {
      "t0": 176,
      "t1": 194,
      "arabic": "بل نقذف بالحق على الباطل فيدمغه فإذا هو زاهق ولكم الويل مما تصفون"
    },
    {
      "t0": 195,
      "t1": 210,
      "arabic": "وله من في السماوات والأرض ومن عنده لا يستكبرون عن عبادته ولا يستحسرون"
    },
    {
      "t0": 211,
      "t1": 220,
      "arabic": "يسبحون الليل والنهار لا يفترون"
    },
    {
      "t0": 307,
      "t1": 311,
      "arabic": "الحمد لله رب العالمين"
