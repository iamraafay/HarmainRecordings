    },
    {
      "t0": 353,
      "t1": 374,
      "arabic": "وما خلقنا السماء والأرض وما بينهما باطلا ذلك ظن الذين كفروا فويل للذين كفروا من النار"
    },
    {
      "t0": 375,
      "t1": 391,
      "arabic": "أم نجعل الذين آمنوا وعملوا الصالحات كالمفسدين في الأرض أم نجعل المتقين كالفجار"
