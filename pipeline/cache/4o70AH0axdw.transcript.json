{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 76,
      "t1": 80,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 80,
      "t1": 83,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 83,
      "t1": 87,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 87,
      "t1": 93,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 94,
      "t1": 99,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 99,
      "t1": 112,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 122,
      "t1": 130,
      "arabic": "إن الله يدفع عن الذين آمنوا"
    },
    {
      "t0": 130,
      "t1": 140,
      "arabic": "إن الله لا يحب كل خوان كفور"
    },
    {
      "t0": 140,
      "t1": 149,
      "arabic": "أذن للذين يقاتلون بأنهم ظلموا"
    },
    {
      "t0": 149,
      "t1": 158,
      "arabic": "وإن الله على نصرهم لقدير"
    },
    {
      "t0": 158,
      "t1": 172,
      "arabic": "الذين أخرجوا من ديارهم بغير حق إلا أن يقولوا ربنا الله"
    },
    {
      "t0": 173,
      "t1": 183,
      "arabic": "ولولا دفع الله الناس بعضهم ببعض لهدمت صوامع"
    },
    {
      "t0": 184,
      "t1": 199,
      "arabic": "لهدمت صوامع وبيع وصلوات ومساجد يذكر فيها اسم الله كثيرا"
    },
    {
      "t0": 199,
      "t1": 208,
      "arabic": "ولينصرن الله من ينصره"
    },
    {
      "t0": 209,
      "t1": 215,
      "arabic": "إن الله لقوي عزيز"
    },
    {
      "t0": 215,
      "t1": 230,
      "arabic": "الذين إن مكناهم في الأرض أقاموا الصلاة وآتوا الزكاة وأمروا بالمعروف"
    },
    {
      "t0": 230,
      "t1": 237,
      "arabic": "وأمروا بالمعروف ونهوا عن المنكر"
    },
    {
      "t0": 237,
      "t1": 243,
      "arabic": "ولله عاقبة الأمور"
    },
    {
      "t0": 243,
      "t1": 256,
      "arabic": "وإن يكذبوك فقد كذبت قبلهم قوم نوح وعاد وثمود"
    },
    {
      "t0": 256,
      "t1": 262,
      "arabic": "وقوم إبراهيم وقوم لوط"
    },
    {
      "t0": 262,
      "t1": 267,
      "arabic": "وأصحاب مدين وكذب موسى"
    },
    {
      "t0": 267,
      "t1": 276,
      "arabic": "فأمليت للكافرين ثم أخذتهم"
    },
    {
      "t0": 276,
      "t1": 281,
      "arabic": "فكيف كان نكير"
    },
    {
      "t0": 365,
      "t1": 370,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 370,
      "t1": 373,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 373,
      "t1": 377,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 377,
      "t1": 383,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 383,
      "t1": 388,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 388,
      "t1": 402,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 411,
      "t1": 424,
      "arabic": "فكأين من قرية أهلكناها وهي ظالمة فهي خاوية"
    },
    {
      "t0": 424,
      "t1": 437,
      "arabic": "فهي خاوية على عروشها وبئر معطلة وقصر مشيد"
    },
    {
      "t0": 438,
      "t1": 448,
      "arabic": "أفلم يسيروا في الأرض فتكون لهم قلوب يعقلون بها"
    },
    {
      "t0": 448,
      "t1": 461,
      "arabic": "فتكون لهم قلوب يعقلون بها أو آذان يسمعون بها"
    },
    {
      "t0": 461,
      "t1": 476,
      "arabic": "فإنها لا تعمى الأبصار ولكن تعمى القلوب التي في الصدور"
    },
    {
      "t0": 478,
      "t1": 488,
      "arabic": "ويستعجلونك بالعذاب ولن يخلف الله وعده"
    },
    {
      "t0": 488,
      "t1": 503,
      "arabic": "وإن يوما عند ربك كألف سنة مما تعدون"
    },
    {
      "t0": 503,
      "t1": 513,
      "arabic": "وكأين من قرية أمليت لها وهي ظالمة"
    },
    {
      "t0": 513,
      "t1": 526,
      "arabic": "ثم أخذتها وإلي المصير"
    }
  ],
  "windows": 2
}
