{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 70,
      "t1": 75,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 75,
      "t1": 80,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 80,
      "t1": 85,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 85,
      "t1": 91,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 91,
      "t1": 97,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 97,
      "t1": 117,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 122,
      "t1": 132,
      "arabic": "وما خلقنا السماوات والأرض وما بينهما إلا بالحق"
    },
    {
      "t0": 132,
      "t1": 142,
      "arabic": "وإن الساعة لآتية فاصفح الصفح الجميل"
    },
    {
      "t0": 142,
      "t1": 150,
      "arabic": "إن ربك هو الخلاق العليم"
    },
    {
      "t0": 150,
      "t1": 161,
      "arabic": "ولقد آتيناك سبعا من المثاني والقرآن العظيم"
    },
    {
      "t0": 161,
      "t1": 176,
      "arabic": "لا تمدن عينيك إلى ما متعنا به أزواجا منهم ولا تحزن عليهم واخفض جناحك للمؤمنين"
    },
    {
      "t0": 176,
      "t1": 188,
      "arabic": "وقل إني أنا النذير المبين"
    },
    {
      "t0": 188,
      "t1": 194,
      "arabic": "كما أنزلنا على المقتسمين"
    },
    {
      "t0": 194,
      "t1": 205,
      "arabic": "الذين جعلوا القرآن عضين"
    },
    {
      "t0": 205,
      "t1": 213,
      "arabic": "فوربك لنسألنهم أجمعين"
    },
    {
      "t0": 213,
      "t1": 220,
      "arabic": "عما كانوا يعملون"
    },
    {
      "t0": 220,
      "t1": 227,
      "arabic": "فاصدع بما تؤمر وأعرض عن المشركين"
    },
    {
      "t0": 227,
      "t1": 233,
      "arabic": "إنا كفيناك المستهزئين"
    },
    {
      "t0": 233,
      "t1": 243,
      "arabic": "الذين يجعلون مع الله إلها آخر فسوف يعلمون"
    },
    {
      "t0": 243,
      "t1": 253,
      "arabic": "ولقد نعلم أنك يضيق صدرك بما يقولون"
    },
    {
      "t0": 253,
      "t1": 262,
      "arabic": "فسبح بحمد ربك وكن من الساجدين"
    },
    {
      "t0": 262,
      "t1": 271,
      "arabic": "واعبد ربك حتى يأتيك اليقين"
    },
    {
      "t0": 346,
      "t1": 352,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 352,
      "t1": 357,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 357,
      "t1": 362,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 362,
      "t1": 368,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 368,
      "t1": 373,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 373,
      "t1": 390,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 398,
      "t1": 404,
      "arabic": "وأنذر عشيرتك الأقربين"
    },
    {
      "t0": 404,
      "t1": 412,
      "arabic": "واخفض جناحك لمن اتبعك من المؤمنين"
    },
    {
      "t0": 412,
      "t1": 423,
      "arabic": "فإن عصوك فقل إني بريء مما تعملون"
    },
    {
      "t0": 423,
      "t1": 429,
      "arabic": "وتوكل على العزيز الرحيم"
    },
    {
      "t0": 429,
      "t1": 435,
      "arabic": "الذي يراك حين تقوم"
    },
    {
      "t0": 435,
      "t1": 440,
      "arabic": "وتقلبك في الساجدين"
    },
    {
      "t0": 440,
      "t1": 446,
      "arabic": "إنه هو السميع العليم"
    },
    {
      "t0": 446,
      "t1": 455,
      "arabic": "هل أنبئكم على من تنزل الشياطين"
    },
    {
      "t0": 455,
      "t1": 461,
      "arabic": "تنزل على كل أفاك أثيم"
    },
    {
      "t0": 461,
      "t1": 468,
      "arabic": "يلقون السمع وأكثرهم كاذبون"
    },
    {
      "t0": 468,
      "t1": 476,
      "arabic": "والشعراء يتبعهم الغاوون"
    },
    {
      "t0": 476,
      "t1": 483,
      "arabic": "ألم تر أنهم في كل واد يهيمون"
    },
    {
      "t0": 483,
      "t1": 491,
      "arabic": "وأنهم يقولون ما لا يفعلون"
    },
    {
      "t0": 491,
      "t1": 500,
      "arabic": "إلا الذين آمنوا وعملوا الصالحات وذكروا الله كثيرا"
    },
    {
      "t0": 500,
      "t1": 511,
      "arabic": "وذكروا الله كثيرا وانتصروا من بعد ما ظلموا"
    },
    {
      "t0": 511,
      "t1": 524,
      "arabic": "وسيعلم الذين ظلموا أي منقلب ينقلبون"
    }
  ],
  "windows": 2
}
