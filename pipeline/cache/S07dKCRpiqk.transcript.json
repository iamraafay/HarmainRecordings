{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 78,
      "t1": 83,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 83,
      "t1": 86,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 86,
      "t1": 90,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 90,
      "t1": 96,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 96,
      "t1": 100,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 100,
      "t1": 116,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 123,
      "t1": 128,
      "arabic": "لا أقسم بيوم القيامة"
    },
    {
      "t0": 128,
      "t1": 134,
      "arabic": "ولا أقسم بالنفس اللوامة"
    },
    {
      "t0": 134,
      "t1": 141,
      "arabic": "أيحسب الإنسان ألن نجمع عظامه"
    },
    {
      "t0": 141,
      "t1": 149,
      "arabic": "بلى قادرين على أن نسوي بنانه"
    },
    {
      "t0": 149,
      "t1": 156,
      "arabic": "بل يريد الإنسان ليفجر أمامه"
    },
    {
      "t0": 156,
      "t1": 161,
      "arabic": "يسأل أيان يوم القيامة"
    },
    {
      "t0": 161,
      "t1": 165,
      "arabic": "فإذا برق البصر"
    },
    {
      "t0": 165,
      "t1": 167,
      "arabic": "وخسف القمر"
    },
    {
      "t0": 167,
      "t1": 171,
      "arabic": "وجمع الشمس والقمر"
    },
    {
      "t0": 171,
      "t1": 179,
      "arabic": "يقول الإنسان يومئذ أين المفر"
    },
    {
      "t0": 179,
      "t1": 182,
      "arabic": "كلا لا وزر"
    },
    {
      "t0": 182,
      "t1": 187,
      "arabic": "إلى ربك يومئذ المستقر"
    },
    {
      "t0": 187,
      "t1": 196,
      "arabic": "ينبأ الإنسان يومئذ بما قدم وأخر"
    },
    {
      "t0": 196,
      "t1": 202,
      "arabic": "بل الإنسان على نفسه بصيرة"
    },
    {
      "t0": 202,
      "t1": 207,
      "arabic": "ولو ألقى معاذيره"
    },
    {
      "t0": 207,
      "t1": 212,
      "arabic": "لا تحرك به لسانك لتعجل به"
    },
    {
      "t0": 212,
      "t1": 218,
      "arabic": "إن علينا جمعه وقرآنه"
    },
    {
      "t0": 218,
      "t1": 223,
      "arabic": "فإذا قرأناه فاتبع قرآنه"
    },
    {
      "t0": 223,
      "t1": 230,
      "arabic": "ثم إن علينا بيانه"
    },
    {
      "t0": 230,
      "t1": 235,
      "arabic": "كلا بل تحبون العاجلة"
    },
    {
      "t0": 235,
      "t1": 239,
      "arabic": "وتذرون الآخرة"
    },
    {
      "t0": 239,
      "t1": 245,
      "arabic": "وجوه يومئذ ناضرة"
    },
    {
      "t0": 245,
      "t1": 249,
      "arabic": "إلى ربها ناظرة"
    },
    {
      "t0": 249,
      "t1": 256,
      "arabic": "ووجوه يومئذ باسرة"
    },
    {
      "t0": 256,
      "t1": 263,
      "arabic": "تظن أن يفعل بها فاقرة"
    },
    {
      "t0": 263,
      "t1": 270,
      "arabic": "كلا إذا بلغت التراقي"
    },
    {
      "t0": 270,
      "t1": 276,
      "arabic": "وقيل من راق"
    },
    {
      "t0": 276,
      "t1": 281,
      "arabic": "وظن أنه الفراق"
    },
    {
      "t0": 281,
      "t1": 288,
      "arabic": "والتفت الساق بالساق"
    },
    {
      "t0": 288,
      "t1": 294,
      "arabic": "إلى ربك يومئذ المساق"
    },
    {
      "t0": 294,
      "t1": 299,
      "arabic": "فلا صدق ولا صلى"
    },
    {
      "t0": 299,
      "t1": 304,
      "arabic": "ولكن كذب وتولى"
    },
    {
      "t0": 304,
      "t1": 313,
      "arabic": "ثم ذهب إلى أهله يتمطى"
    },
    {
      "t0": 313,
      "t1": 316,
      "arabic": "أولى لك فأولى"
    },
    {
      "t0": 316,
      "t1": 321,
      "arabic": "ثم أولى لك فأولى"
    },
    {
      "t0": 321,
      "t1": 329,
      "arabic": "أيحسب الإنسان أن يترك سدى"
    },
    {
      "t0": 329,
      "t1": 337,
      "arabic": "ألم يك نطفة من مني يمنى"
    },
    {
      "t0": 337,
      "t1": 344,
      "arabic": "ثم كان علقة فخلق فسوى"
    },
    {
      "t0": 344,
      "t1": 353,
      "arabic": "فجعل منه الزوجين الذكر والأنثى"
    },
    {
      "t0": 353,
      "t1": 365,
      "arabic": "أليس ذلك بقادر على أن يحيي الموتى"
    },
    {
      "t0": 441,
      "t1": 446,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 446,
      "t1": 449,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 449,
      "t1": 454,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 454,
      "t1": 459,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 459,
      "t1": 464,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 464,
      "t1": 480,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 489,
      "t1": 495,
      "arabic": "لا أقسم بهذا البلد"
    },
    {
      "t0": 495,
      "t1": 501,
      "arabic": "وأنت حل بهذا البلد"
    },
    {
      "t0": 501,
      "t1": 506,
      "arabic": "ووالد وما ولد"
    },
    {
      "t0": 506,
      "t1": 512,
      "arabic": "لقد خلقنا الإنسان في كبد"
    },
    {
      "t0": 512,
      "t1": 519,
      "arabic": "أيحسب أن لن يقدر عليه أحد"
    },
    {
      "t0": 519,
      "t1": 524,
      "arabic": "يقول أهلكت مالا لبدا"
    },
    {
      "t0": 524,
      "t1": 531,
      "arabic": "أيحسب أن لم يره أحد"
    },
    {
      "t0": 531,
      "t1": 536,
      "arabic": "ألم نجعل له عينين"
    },
    {
      "t0": 536,
      "t1": 540,
      "arabic": "ولسانا وشفتين"
    },
    {
      "t0": 540,
      "t1": 546,
      "arabic": "وهديناه النجدين"
    },
    {
      "t0": 546,
      "t1": 549,
      "arabic": "فلا اقتحم العقبة"
    },
    {
      "t0": 549,
      "t1": 554,
      "arabic": "وما أدراك ما العقبة"
    },
    {
      "t0": 554,
      "t1": 557,
      "arabic": "فك رقبة"
    },
    {
      "t0": 557,
      "t1": 564,
      "arabic": "أو إطعام في يوم ذي مسغبة"
    },
    {
      "t0": 564,
      "t1": 568,
      "arabic": "يتيما ذا مقربة"
    },
    {
      "t0": 568,
      "t1": 573,
      "arabic": "أو مسكينا ذا متربة"
    },
    {
      "t0": 573,
      "t1": 584,
      "arabic": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"
    },
    {
      "t0": 584,
      "t1": 591,
      "arabic": "أولئك أصحاب الميمنة"
    },
    {
      "t0": 591,
      "t1": 599,
      "arabic": "والذين كفروا بآياتنا هم أصحاب المشأمة"
    },
    {
      "t0": 599,
      "t1": 605,
      "arabic": "عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ"
    }
  ],
  "windows": 2
}
