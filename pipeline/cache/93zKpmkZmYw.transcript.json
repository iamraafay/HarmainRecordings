{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 63,
      "t1": 66,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 66,
      "t1": 69,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 70,
      "t1": 73,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 74,
      "t1": 78,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 79,
      "t1": 87,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 87,
      "t1": 98,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 105,
      "t1": 107,
      "arabic": "والشمس وضحاها"
    },
    {
      "t0": 107,
      "t1": 110,
      "arabic": "والقمر إذا تلاها"
    },
    {
      "t0": 111,
      "t1": 114,
      "arabic": "والنهار إذا جلاها"
    },
    {
      "t0": 115,
      "t1": 118,
      "arabic": "والليل إذا يغشاها"
    },
    {
      "t0": 119,
      "t1": 124,
      "arabic": "والسماء وما بناها"
    },
    {
      "t0": 125,
      "t1": 128,
      "arabic": "والأرض وما طحاها"
    },
    {
      "t0": 129,
      "t1": 131,
      "arabic": "ونفس وما سواها"
    },
    {
      "t0": 132,
      "t1": 136,
      "arabic": "فألمها فجورها وتقواها"
    },
    {
      "t0": 137,
      "t1": 140,
      "arabic": "قد أفلح من زكاها"
    },
    {
      "t0": 141,
      "t1": 146,
      "arabic": "وقد خاب من دساها"
    },
    {
      "t0": 147,
      "t1": 151,
      "arabic": "كذبت ثمود بطغواها"
    },
    {
      "t0": 152,
      "t1": 155,
      "arabic": "إذ انبعث أشقَاها"
    },
    {
      "t0": 156,
      "t1": 163,
      "arabic": "فقال لهم رسول الله ناقة الله وسقياها"
    },
    {
      "t0": 164,
      "t1": 167,
      "arabic": "فكذبوه فعقروها"
    },
    {
      "t0": 168,
      "t1": 176,
      "arabic": "فدمدم عليهم ربهم بذنبهم فسواها"
    },
    {
      "t0": 177,
      "t1": 182,
      "arabic": "ولا يخاف عقباها"
    },
    {
      "t0": 260,
      "t1": 263,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 264,
      "t1": 267,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 267,
      "t1": 270,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 271,
      "t1": 276,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 276,
      "t1": 285,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 285,
      "t1": 296,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 302,
      "t1": 304,
      "arabic": "والليل إذا يغشى"
    },
    {
      "t0": 305,
      "t1": 307,
      "arabic": "والنهار إذا تجلى"
    },
    {
      "t0": 308,
      "t1": 312,
      "arabic": "وما خلق الذكر والأنثى"
    },
    {
      "t0": 313,
      "t1": 316,
      "arabic": "إن سعيكم لشتى"
    },
    {
      "t0": 317,
      "t1": 323,
      "arabic": "فأما من أعطى واتقى وصدق بالحسنى"
    },
    {
      "t0": 324,
      "t1": 327,
      "arabic": "فسنيسره لليسرى"
    },
    {
      "t0": 328,
      "t1": 335,
      "arabic": "وأما من بخل واستغنى وكذب بالحسنى"
    },
    {
      "t0": 336,
      "t1": 339,
      "arabic": "فسنيسره للعسرى"
    },
    {
      "t0": 340,
      "t1": 347,
      "arabic": "وما يغني عنه ماله إذا تردى"
    },
    {
      "t0": 348,
      "t1": 351,
      "arabic": "إن علينا للهدى"
    },
    {
      "t0": 351,
      "t1": 355,
      "arabic": "وإن لنا للآخرة والأولى"
    },
    {
      "t0": 357,
      "t1": 362,
      "arabic": "فأنذرتكم نارا تلظى"
    },
    {
      "t0": 363,
      "t1": 369,
      "arabic": "لا يصلاها إلا الأشقى"
    },
    {
      "t0": 370,
      "t1": 373,
      "arabic": "الذي كذب وتولى"
    },
    {
      "t0": 374,
      "t1": 378,
      "arabic": "وسيجنبها الأتقى"
    },
    {
      "t0": 378,
      "t1": 383,
      "arabic": "الذي يؤتي ماله يتزكى"
    },
    {
      "t0": 383,
      "t1": 391,
      "arabic": "وما لأحد عنده من نعمة تجزى"
    },
    {
      "t0": 392,
      "t1": 401,
      "arabic": "إلا ابتغاء وجه ربه الأعلى"
    },
    {
      "t0": 402,
      "t1": 407,
      "arabic": "ولسوف يرضى"
    }
  ],
