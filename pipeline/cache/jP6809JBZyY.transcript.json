{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 86,
      "t1": 91,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 92,
      "t1": 95,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 96,
      "t1": 99,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 100,
      "t1": 106,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 107,
      "t1": 112,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 113,
      "t1": 117,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 118,
      "t1": 132,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 138,
      "t1": 142,
      "arabic": "واتل عليهم نبأ إبراهيم"
    },
    {
      "t0": 143,
      "t1": 149,
      "arabic": "إذ قال لأبيه وقومه ما تعبدون"
    },
    {
      "t0": 150,
      "t1": 158,
      "arabic": "قالوا نعبد أصناما فنظل لها عاكفين"
    },
    {
      "t0": 159,
      "t1": 165,
      "arabic": "قال هل يسمعونكم إذ تدعون"
    },
    {
      "t0": 166,
      "t1": 172,
      "arabic": "أو ينفعونكم أو يضرون"
    },
    {
      "t0": 173,
      "t1": 184,
      "arabic": "قالوا بل وجدنا آباءنا كذلك يفعلون"
    },
    {
      "t0": 185,
      "t1": 193,
      "arabic": "قال أفرايتم ما كنتم تعبدون"
    },
    {
      "t0": 194,
      "t1": 201,
      "arabic": "أنتم وآباؤكم الأقدمون"
    },
    {
      "t0": 202,
      "t1": 209,
      "arabic": "فإنهم عدو لي إلا رب العالمين"
    },
    {
      "t0": 210,
      "t1": 215,
      "arabic": "الذي خلقني فهو يهدين"
    },
    {
      "t0": 216,
      "t1": 221,
      "arabic": "والذي هو يطعمني ويسقين"
    },
    {
      "t0": 222,
      "t1": 226,
      "arabic": "وإذا مرضت فهو يشفين"
    },
    {
      "t0": 227,
      "t1": 233,
      "arabic": "والذي يميتني ثم يحيين"
    },
    {
      "t0": 234,
      "t1": 244,
      "arabic": "والذي أطمع أن يغفر لي خطيئتي يوم الدين"
    },
    {
      "t0": 245,
      "t1": 251,
      "arabic": "رب هب لي حكما وألحقني بالصالحين"
    },
    {
      "t0": 252,
      "t1": 257,
      "arabic": "واجعل لي لسان صدق في الآخرين"
    },
    {
      "t0": 258,
      "t1": 265,
      "arabic": "واجعلني من ورثة جنة النعيم"
    },
    {
      "t0": 266,
      "t1": 279,
      "arabic": "واغفر لأبي إنه كان من الضالين"
    },
    {
      "t0": 280,
      "t1": 289,
      "arabic": "ولا تخزني يوم يبعثون"
    },
    {
      "t0": 290,
      "t1": 297,
      "arabic": "يوم لا ينفع مال ولا بنون"
    },
    {
      "t0": 298,
      "t1": 307,
      "arabic": "إلا من أتى الله بقلب سليم"
    },
    {
      "t0": 390,
      "t1": 394,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 395,
      "t1": 399,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 400,
      "t1": 403,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 404,
      "t1": 409,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 410,
      "t1": 414,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 415,
      "t1": 420,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 421,
      "t1": 433,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 438,
      "t1": 449,
      "arabic": "قد كانت لكم أسوة حسنة في إبراهيم والذين معه إذ قالوا"
    },
    {
      "t0": 450,
      "t1": 464,
      "arabic": "إذ قالوا لقومهم إنا برآء منكم ومما تعبدون من دون الله"
    },
    {
      "t0": 465,
      "t1": 476,
      "arabic": "كفرنا بكم وبدا بيننا وبينكم العداوة والبغضاء أبدا"
    },
    {
      "t0": 477,
      "t1": 490,
      "arabic": "وبدا بيننا وبينكم العداوة والبغضاء أبدا حتى تؤمنوا بالله وحده"
    },
    {
      "t0": 490,
      "t1": 498,
      "arabic": "إلا قول إبراهيم لأبيه لأستغفرن لك"
    },
    {
      "t0": 499,
      "t1": 504,
      "arabic": "وما أملك لك من الله من شيء"
    },
    {
      "t0": 505,
      "t1": 513,
      "arabic": "ربنا عليك توكلنا وإليك أنبنا وإليك المصير"
    },
    {
      "t0": 514,
      "t1": 523,
      "arabic": "ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا"
    },
    {
      "t0": 524,
      "t1": 530,
      "arabic": "إنك أنت العزيز الحكيم"
    },
    {
      "t0": 531,
      "t1": 539,
      "arabic": "لقد كان لكم فيهم أسوة حسنة لمن كان"
    },
    {
      "t0": 540,
      "t1": 552,
      "arabic": "لقد كان لكم فيهم أسوة حسنة لمن كان يرجو الله واليوم الآخر"
    },
    {
      "t0": 553,
      "t1": 564,
      "arabic": "لقد كان لكم فيهم أسوة حسنة لمن كان يرجو الله واليوم الآخر"
    },
    {
      "t0": 565,
      "t1": 574,
      "arabic": "ومن يتول فإن الله هو الغني الحميد"
    }
  ],
  "windows": 2
}
