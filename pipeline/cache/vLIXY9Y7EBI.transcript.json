    {
      "t0": 116,
      "t1": 124,
      "arabic": "وَمَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّ"
    },
    {
      "t0": 125,
      "t1": 133,
      "arabic": "وَإِنَّ السَّاعَةَ لَآتِيَةٌ ۖ فَاصْفَحِ الصَّفْحَ الْجَمِيلَ"
    },
    {
      "t0": 134,
      "t1": 140,
      "arabic": "إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ"
    },
    {
      "t0": 141,
      "t1": 149,
      "arabic": "وَلَقَدْ آتَيْنَاكَ سَبْعًا مِّنَ الْمَثَانِي وَالْقُرْآنَ الْعَظِيمَ"
    },
    {
      "t0": 150,
      "t1": 159,
      "arabic": "لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِّنْهُمْ"
    },
    {
      "t0": 160,
      "t1": 167,
      "arabic": "وَلَا تَحْزَنْ عَلَيْهِمْ وَاخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ"
    },
    {
      "t0": 168,
      "t1": 173,
      "arabic": "وَقُلْ إِنِّي أَنَا النَّذِيرُ الْمُبِينُ"
