    },
    {
      "t0": 114,
      "t1": 125,
      "arabic": "يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد واتقوا الله"
    },
    {
      "t0": 125,
      "t1": 131,
      "arabic": "إن الله خبير بما تعملون"
    },
    {
      "t0": 132,
      "t1": 146,
      "arabic": "ولا تكونوا كالذين نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون"
    },
    {
      "t0": 146,
      "t1": 163,
      "arabic": "لا يستوي أصحاب النار وأصحاب الجنة أصحاب الجنة هم الفائزون"
    },
    {
      "t0": 163,
      "t1": 184,
      "arabic": "لو أنزلنا هذا القرآن على جبل لرأيته خاشعا متصدعا من خشية الله"
    },
    {
      "t0": 184,
      "t1": 196,
      "arabic": "وتلك الأمثال نضربها للناس لعلهم يتفكرون"
