      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"
    },
    {
      "t0": 83,
      "t1": 96,
      "arabic": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 102,
      "t1": 106,
      "arabic": "هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ"
    },
    {
      "t0": 106,
      "t1": 110,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌ"
    },
    {
      "t0": 110,
      "t1": 115,
      "arabic": "عَامِلَةٌ نَّاصِبَةٌ"
    },
    {
      "t0": 115,
      "t1": 119,
      "arabic": "تَصْلَىٰ نَارًا حَامِيَةً"
    },
    {
      "t0": 119,
      "t1": 123,
      "arabic": "تُسْقَىٰ مِنْ عَيْنٍ آنِيَةٍ"
    },
    {
      "t0": 123,
      "t1": 129,
      "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"
    },
    {
      "t0": 129,
      "t1": 135,
      "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِي مِن جُوعٍ"
    },
    {
      "t0": 135,
      "t1": 140,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"
    },
    {
      "t0": 140,
      "t1": 144,
      "arabic": "لِّسَعْيِهَا رَاضِيَةٌ"
    },
    {
      "t0": 144,
      "t1": 149,
      "arabic": "فِي جَنَّةٍ عَالِيَةٍ"
    },
    {
      "t0": 150,
      "t1": 153,
      "arabic": "لَّا تَسْمَعُ فِيهَا لَاغِيَةً"
    },
    {
      "t0": 153,
      "t1": 158,
      "arabic": "فِيهَا عَيْنٌ جَارِيَةٌ"
    },
    {
      "t0": 158,
      "t1": 162,
      "arabic": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ"
    },
    {
      "t0": 162,
      "t1": 166,
      "arabic": "وَأَكْوَابٌ مَّوُضُوعَةٌ"
    },
    {
      "t0": 166,
      "t1": 170,
      "arabic": "وَنَمَارِقُ مَصْفُوفَةٌ"
    },
    {
      "t0": 170,
      "t1": 174,
      "arabic": "وَزَرَابِيُّ مَبْثُوثَةٌ"
    },
    {
      "t0": 174,
      "t1": 180,
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ"
    },
    {
      "t0": 180,
      "t1": 188,
      "arabic": "وَإِلَى السَّمَاءِ كَيْفَ رُفِعَتْ"
