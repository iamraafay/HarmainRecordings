      "t1": 138,
      "arabic": "وقضى ربك ألا تعبدوا إلا إياه وبالوالدين إحسانا"
    },
    {
      "t0": 139,
      "t1": 165,
      "arabic": "إما يبلغن عندك الكبر أحدهما أو كلاهما فلا تقل لهما أف ولا تنهرهما وقل لهما قولا كريما"
    },
    {
      "t0": 165,
      "t1": 181,
      "arabic": "واخفض لهما جناح الذل من الرحمة وقل رب ارحمهما كما ربياني صغيرا"
