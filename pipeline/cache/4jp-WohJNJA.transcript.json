      "t1": 118,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 124,
      "t1": 127,
      "arabic": "والضحى"
    },
    {
      "t0": 127,
      "t1": 130,
      "arabic": "والليل إذا سجى"
    },
    {
      "t0": 130,
      "t1": 134,
      "arabic": "ما ودعك ربك وما قلى"
    },
    {
      "t0": 134,
      "t1": 140,
      "arabic": "وللآخرة خير لك من الأولى"
    },
    {
      "t0": 140,
      "t1": 146,
      "arabic": "ولسوف يعطيك ربك فترضى"
    },
    {
      "t0": 146,
      "t1": 153,
      "arabic": "ألم يجدك يتيما فآوى"
    },
    {
      "t0": 153,
      "t1": 162,
      "arabic": "ووجدك ضالا فهدى"
    },
    {
      "t0": 162,
      "t1": 171,
      "arabic": "ووجدك عائلا فأغنى"
    },
    {
      "t0": 171,
      "t1": 177,
      "arabic": "فأما اليتيم فلا تقهر"
    },
    {
      "t0": 177,
      "t1": 185,
      "arabic": "وأما السائل فلا تنهر"
    },
    {
      "t0": 185,
      "t1": 193,
      "arabic": "وأما بنعمة ربك فحدث"
