    },
    {
      "t0": 117,
      "t1": 123,
      "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
    },
    {
      "t0": 123,
      "t1": 127,
      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"
    },
    {
      "t0": 127,
      "t1": 143,
      "arabic": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 155,
      "t1": 160,
      "arabic": "الْحَاقَّةُ"
    },
    {
      "t0": 161,
      "t1": 166,
      "arabic": "مَا الْحَاقَّةُ"
    },
    {
      "t0": 166,
      "t1": 174,
      "arabic": "وَمَا أَدْرَاكَ مَا الْحَاقَّةُ"
    },
    {
      "t0": 175,
      "t1": 180,
      "arabic": "كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ"
    },
    {
      "t0": 181,
      "t1": 187,
      "arabic": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا بِالطَّاغِيَةِ"
    },
    {
      "t0": 187,
      "t1": 196,
      "arabic": "وَأَمَّا عَادٌ فَأُهْلِكُوا بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ"
    },
    {
      "t0": 196,
      "t1": 205,
      "arabic": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ أَيَّامٍ حُسُومًا"
    },
    {
      "t0": 205,
      "t1": 214,
      "arabic": "فَتَرَى الْقَوْمَ فِيهَا صَرْعَى كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ"
    },
    {
      "t0": 215,
      "t1": 220,
      "arabic": "فَهَلْ تَرَى لَهُم مِّن بَاقِيَةٍ"
    },
    {
      "t0": 221,
      "t1": 231,
      "arabic": "وَجَاءَ فِرْعَوْنُ وَمَن قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِ"
    },
    {
      "t0": 231,
      "t1": 239,
      "arabic": "فَعَصَوْا رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً"
    },
    {
      "t0": 239,
      "t1": 249,
      "arabic": "إِنَّا لَمَّا طَغَى الْمَاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِ"
    },
    {
      "t0": 250,
      "t1": 259,
      "arabic": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَا أُذُنٌ وَاعِيَةٌ"
    },
    {
      "t0": 260,
      "t1": 266,
      "arabic": "فَإِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌ"
    },
    {
      "t0": 267,
      "t1": 274,
      "arabic": "وَحُمِلَتِ الْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً"
    },
    {
      "t0": 275,
      "t1": 281,
      "arabic": "فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُ"
    },
    {
      "t0": 281,
      "t1": 291,
      "arabic": "وَانشَقَّتِ السَّمَاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌ"
    },
    {
      "t0": 291,
      "t1": 300,
      "arabic": "وَالْمَلَكُ عَلَى أَرْجَائِهَا"
    },
    {
      "t0": 301,
      "t1": 309,
      "arabic": "وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ"
    },
    {
      "t0": 309,
      "t1": 319,
      "arabic": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَى مِنكُمْ خَافِيَةٌ"
    },
    {
      "t0": 320,
      "t1": 332,
      "arabic": "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَيَقُولُ هَاؤُمُ اقْرَءُوا كِتَابِيَهْ"
    },
    {
      "t0": 332,
      "t1": 341,
      "arabic": "إِنِّي ظَنَنتُ أَنِّي مُلَاقٍ حِسَابِيَهْ"
    },
    {
      "t0": 341,
      "t1": 345,
