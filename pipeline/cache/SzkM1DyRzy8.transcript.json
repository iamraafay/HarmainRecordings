    {
      "t0": 59,
      "t1": 61,
      "arabic": "الرَّحْمَٰنِ الرَّحِيمِ"
    },
    {
      "t0": 61,
      "t1": 64,
      "arabic": "مَالِكِ يَوْمِ الدِّينِ"
    },
    {
      "t0": 64,
      "t1": 69,
      "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
    },
    {
      "t0": 69,
      "t1": 73,
      "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"
    },
    {
      "t0": 73,
      "t1": 77,
      "arabic": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ"
    },
    {
      "t0": 77,
      "t1": 87,
      "arabic": "غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "t0": 92,
      "t1": 94,
      "arabic": "سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى"
    },
    {
      "t0": 94,
      "t1": 96,
      "arabic": "الَّذِي خَلَقَ فَسَوَّى"
    },
    {
      "t0": 96,
      "t1": 98,
      "arabic": "وَالَّذِي قَدَّرَ فَهَدَى"
    },
    {
      "t0": 98,
      "t1": 100,
      "arabic": "وَالَّذِي أَخْرَجَ الْمَرْعَى"
    },
    {
      "t0": 100,
      "t1": 106,
      "arabic": "فَجَعَلَهُ غُثَاءً أَحْوَى"
    },
    {
      "t0": 106,
      "t1": 109,
      "arabic": "سَنُقْرِئُكَ فَلَا تَنسَى"
    },
    {
      "t0": 109,
      "t1": 118,
      "arabic": "إِلَّا مَا شَاءَ اللَّهُ ۚ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَى"
    },
    {
      "t0": 118,
      "t1": 121,
      "arabic": "وَنُيَسِّرُكَ لِلْيُسْرَى"
    },
    {
      "t0": 121,
      "t1": 125,
      "arabic": "فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَى"
    },
    {
      "t0": 125,
      "t1": 128,
      "arabic": "سَيَذَّكَّرُ مَن يَخْشَى"
    },
    {
      "t0": 128,
      "t1": 131,
      "arabic": "وَيَتَجَنَّبُهَا الْأَشْقَى"
    },
    {
      "t0": 131,
      "t1": 135,
      "arabic": "الَّذِي يَصْلَى النَّارَ الْكُبْرَى"
    },
    {
      "t0": 135,
      "t1": 140,
      "arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى"
    },
    {
      "t0": 140,
      "t1": 144,
      "arabic": "قَدْ أَفْلَحَ مَن تَزَكَّى"
    },
    {
      "t0": 144,
      "t1": 149,
      "arabic": "وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى"
    },
    {
      "t0": 149,
      "t1": 154,
      "arabic": "بَلْ تُؤْثِرُونَ الْحَيَاةَ الدُّنْيَا"
    },
    {
      "t0": 154,
      "t1": 159,
      "arabic": "وَالْآخِرَةُ خَيْرٌ وَأَبْقَى"
    },
    {
      "t0": 159,
      "t1": 164,
      "arabic": "إِنَّ هَٰذَا لَفِي الصُّحُفِ الْأُولَى"
    },
    {
      "t0": 164,
      "t1": 168,
      "arabic": "صُحُفِ إِبْرَاهِيمَ وَمُوسَى"
    },
    {
