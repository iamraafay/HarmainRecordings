  "segments": [
    {
      "t0": 71,
      "t1": 73,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 74,
      "t1": 77,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 78,
      "t1": 81,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 82,
      "t1": 86,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 87,
      "t1": 93,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 94,
      "t1": 103,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 110,
      "t1": 114,
      "arabic": "إذا السماء انفطرت"
    },
    {
      "t0": 115,
      "t1": 117,
      "arabic": "وإذا الكواكب انتثرت"
    },
    {
      "t0": 118,
      "t1": 120,
      "arabic": "وإذا البحار فجرت"
    },
    {
      "t0": 121,
      "t1": 123,
      "arabic": "وإذا القبور بعثرت"
    },
    {
      "t0": 124,
      "t1": 128,
      "arabic": "علمت نفس ما قدمت وأخرت"
    },
    {
      "t0": 129,
      "t1": 137,
      "arabic": "يا أيها الإنسان ما غرك بربك الكريم"
    },
    {
      "t0": 137,
      "t1": 142,
      "arabic": "الذي خلقك فسواك فعدلك"
    },
    {
      "t0": 143,
      "t1": 149,
      "arabic": "في أي صورة ما شاء ركبك"
    },
    {
      "t0": 150,
      "t1": 154,
      "arabic": "كلا بل تكذبون بالدين"
    },
    {
      "t0": 154,
      "t1": 157,
      "arabic": "وإن عليكم لحافظين"
    },
    {
      "t0": 158,
      "t1": 160,
      "arabic": "كراما كاتبين"
    },
    {
      "t0": 161,
      "t1": 166,
      "arabic": "يعلمون ما تفعلون"
    },
    {
      "t0": 234,
      "t1": 238,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 239,
      "t1": 242,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 243,
