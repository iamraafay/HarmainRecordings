    {
      "t0": 211,
      "t1": 221,
      "arabic": "وَالَّذِي أَطْمَعُ أَن يَغْفِرَ لِي خَطِيئَتِي يَوْمَ الدِّينِ"
    },
    {
      "t0": 221,
      "t1": 228,
