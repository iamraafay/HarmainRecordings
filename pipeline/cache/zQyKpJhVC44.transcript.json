    {
      "t0": 153,
      "t1": 170,
      "arabic": "قَالَ أَفَرَأَيْتُم مَّا كُنتُمْ تَعْبُدُونَ ۝ أَنتُمْ وَآبَاؤُكُمُ الْأَقْدَمُونَ"
    },
    {
      "t0": 170,
      "t1": 177,
      "arabic": "فَإِنَّهُمْ عَدُوٌّ لِّي إِلَّا رَبَّ الْعَالَمِينَ"
    },
    {
      "t0": 177,
      "t1": 181,
      "arabic": "الَّذِي خَلَقَنِي فَهُوَ يَهْدِينِ"
