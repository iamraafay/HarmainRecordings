{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 75,
      "t1": 79,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 79,
      "t1": 82,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 82,
      "t1": 86,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 86,
      "t1": 91,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 91,
      "t1": 99,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 99,
      "t1": 108,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 114,
      "t1": 127,
      "arabic": "إن الذين لا يؤمنون بالآخرة ليسمون الملائكة تسمية الأنثى"
    },
    {
      "t0": 127,
      "t1": 143,
      "arabic": "وما لهم به من علم إن يتبعون إلا الظن وإن الظن لا يغني من الحق شيئا"
    },
    {
      "t0": 143,
      "t1": 153,
      "arabic": "فأعرض عن من تولى عن ذكرنا ولم يرد إلا الحياة الدنيا"
    },
    {
      "t0": 153,
      "t1": 169,
      "arabic": "ذلك مبلغهم من العلم إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بمن اهتدى"
    },
    {
      "t0": 169,
      "t1": 187,
      "arabic": "ولله ما في السماوات وما في الأرض ليجزي الذين أساءوا بما عملوا ويجزي الذين أحسنوا بالحسنى"
    },
    {
      "t0": 187,
      "t1": 206,
      "arabic": "الذين يجتنبون كبائر الإثم والفواحش إلا اللمم إن ربك واسع المغفرة هو أعلم بكم"
    },
    {
      "t0": 206,
      "t1": 219,
      "arabic": "إذ أنشأكم من الأرض وإذ أنتم أجنة في بطون أمهاتكم"
    },
    {
      "t0": 219,
      "t1": 234,
      "arabic": "فلا تزكوا أنفسكم هو أعلم بمن اتقى"
    },
    {
      "t0": 311,
      "t1": 315,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 315,
      "t1": 317,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 317,
      "t1": 321,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 321,
      "t1": 327,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 327,
      "t1": 332,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 332,
      "t1": 336,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 336,
      "t1": 348,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 353,
      "t1": 362,
      "arabic": "أفرأيت الذي تولى وأعطى قليلا وأكدى"
    },
    {
      "t0": 362,
      "t1": 367,
      "arabic": "أعنده علم الغيب فهو يرى"
    },
    {
      "t0": 367,
      "t1": 377,
      "arabic": "أم لم ينبأ بما في صحف موسى وإبراهيم الذي وفى"
    },
    {
      "t0": 377,
      "t1": 383,
      "arabic": "ألا تزر وازرة وزر أخرى"
    },
    {
      "t0": 383,
      "t1": 389,
      "arabic": "وأن ليس للإنسان إلا ما سعى"
    },
    {
      "t0": 389,
      "t1": 393,
      "arabic": "وأن سعيه سوف يرى"
    },
    {
      "t0": 393,
      "t1": 401,
      "arabic": "ثم يجزاها الجزاء الأوفى"
    },
    {
      "t0": 401,
      "t1": 407,
      "arabic": "وأن إلى ربك المنتهى"
    },
    {
      "t0": 407,
      "t1": 412,
      "arabic": "وأنه هو أضحك وأبكى"
    },
    {
      "t0": 412,
      "t1": 417,
      "arabic": "وأنه هو أمات وأحيا"
    },
    {
      "t0": 417,
      "t1": 425,
      "arabic": "وأنه خلق الزوجين الذكر والأنثى"
    },
    {
      "t0": 425,
      "t1": 429,
      "arabic": "من نطفة إذا تمنى"
    },
    {
      "t0": 429,
      "t1": 438,
      "arabic": "وأن عليه النشأة الأخرى"
    }
  ],
  "windows": 2
