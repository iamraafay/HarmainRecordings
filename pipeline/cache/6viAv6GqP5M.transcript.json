{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 62,
      "t1": 66,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 66,
      "t1": 69,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 69,
      "t1": 73,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 74,
      "t1": 80,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 81,
      "t1": 85,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 85,
      "t1": 89,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 90,
      "t1": 103,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 111,
      "t1": 114,
      "arabic": "والنجم إذا هوى"
    },
    {
      "t0": 114,
      "t1": 117,
      "arabic": "ما ضل صاحبكم وما غوى"
    },
    {
      "t0": 117,
      "t1": 120,
      "arabic": "وما ينطق عن الهوى"
    },
    {
      "t0": 120,
      "t1": 124,
      "arabic": "إن هو إلا وحي يوحى"
    },
    {
      "t0": 124,
      "t1": 128,
      "arabic": "علمه شديد القوى"
    },
    {
      "t0": 128,
      "t1": 131,
      "arabic": "ذو مرة فاستوى"
    },
    {
      "t0": 131,
      "t1": 134,
      "arabic": "وهو بالأفق الأعلى"
    },
    {
      "t0": 134,
      "t1": 138,
      "arabic": "ثم دنا فتدلى"
    },
    {
      "t0": 138,
      "t1": 143,
      "arabic": "فأوحى إلى عبده ما أوحى"
    },
    {
      "t0": 144,
      "t1": 148,
      "arabic": "فكان قاب قوسين أو أدنى"
    },
    {
      "t0": 148,
      "t1": 151,
      "arabic": "فأوحى إلى عبده ما أوحى"
    },
    {
      "t0": 152,
      "t1": 155,
      "arabic": "ما كذب الفؤاد ما رأى"
    },
    {
      "t0": 156,
      "t1": 159,
      "arabic": "أفتمارونه على ما يرى"
    },
    {
      "t0": 160,
      "t1": 163,
      "arabic": "ولقد رآه نزلة أخرى"
    },
    {
      "t0": 163,
      "t1": 167,
      "arabic": "عند سدرة المنتهى"
    },
    {
      "t0": 167,
      "t1": 171,
      "arabic": "عندها جنة المأوى"
    },
    {
      "t0": 171,
      "t1": 175,
      "arabic": "إذ يغشى السدرة ما يغشى"
    },
    {
      "t0": 175,
      "t1": 178,
      "arabic": "ما زاغ البصر وما طغى"
    },
    {
      "t0": 178,
      "t1": 183,
      "arabic": "لقد رأى من آيات ربه الكبرى"
    },
    {
      "t0": 183,
      "t1": 187,
      "arabic": "أفرأيتم اللات والعزى"
    },
    {
      "t0": 187,
      "t1": 190,
      "arabic": "ومناة الثالثة الأخرى"
    },
    {
      "t0": 190,
      "t1": 195,
      "arabic": "ألكم الذكر وله الأنثى"
    },
    {
      "t0": 195,
      "t1": 200,
      "arabic": "تلك إذا قسمة ضيزى"
    },
    {
      "t0": 200,
      "t1": 216,
      "arabic": "إن هي إلا أسماء سميتموها أنتم وآباؤكم ما أنزل الله بها من سلطان"
    },
    {
      "t0": 216,
      "t1": 228,
      "arabic": "إن يتبعون إلا الظن وما تهوى الأنفس ولقد جاءهم من ربهم الهدى"
    },
    {
      "t0": 228,
      "t1": 233,
      "arabic": "أم للإنسان ما تمنى"
    },
    {
      "t0": 233,
      "t1": 237,
      "arabic": "فلله الآخرة والأولى"
    },
    {
      "t0": 237,
      "t1": 260,
      "arabic": "وكم من ملك في السماوات لا تغني شفاعتهم شيئا إلا من بعد أن يأذن الله لمن يشاء ويرضى"
    },
    {
      "t0": 260,
      "t1": 272,
      "arabic": "إن الذين لا يؤمنون بالآخرة ليسمون الملائكة تسمية الأنثى"
    },
    {
      "t0": 272,
      "t1": 286,
      "arabic": "وما لهم به من علم إن يتبعون إلا الظن وإن الظن لا يغني من الحق شيئا"
    },
    {
      "t0": 286,
      "t1": 297,
      "arabic": "فأعرض عن من تولى عن ذكرنا ولم يرد إلا الحياة الدنيا"
    },
    {
      "t0": 297,
      "t1": 311,
      "arabic": "ذلك مبلغهم من العلم إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بمن اهتدى"
    },
    {
      "t0": 403,
      "t1": 408,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 408,
      "t1": 411,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 411,
      "t1": 414,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 415,
      "t1": 420,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 421,
      "t1": 425,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 425,
      "t1": 430,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 431,
      "t1": 442,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 448,
      "t1": 471,
      "arabic": "ولله ما في السماوات وما في الأرض ليجزي الذين أساءوا بما عملوا ويجزي الذين أحسنوا بالحسنى"
    },
    {
      "t0": 471,
      "t1": 511,
      "arabic": "الذين يجتنبون كبائر الإثم والفواحش إلا اللمم إن ربك واسع المغفرة هو أعلم بكم إذ أنشأكم من الأرض وإذ أنتم أجنه في بطون أمهاتكم فلا تزكوا أنفسكم هو أعلم بمن اتقى"
    },
    {
      "t0": 511,
      "t1": 515,
      "arabic": "أفرأيت الذي تولى"
    },
    {
      "t0": 515,
      "t1": 521,
      "arabic": "وأعطى قليلا وأكدى"
    },
    {
      "t0": 521,
      "t1": 526,
      "arabic": "عنده علم الغيب فهو يرى"
    },
    {
      "t0": 526,
      "t1": 530,
      "arabic": "أم لم ينبأ بما في صحف موسى"
    },
    {
      "t0": 531,
      "t1": 534,
      "arabic": "وإبراهيم الذي وفى"
    },
    {
      "t0": 534,
      "t1": 539,
      "arabic": "ألا تزر وازرة وزر أخرى"
    },
    {
      "t0": 539,
      "t1": 547,
      "arabic": "وأن ليس للإنسان إلا ما سعى"
    }
  ],
  "windows": 2
}
