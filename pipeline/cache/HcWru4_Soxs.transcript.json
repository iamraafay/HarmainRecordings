      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 80,
      "t1": 83,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 84,
      "t1": 89,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 90,
      "t1": 96,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 97,
      "t1": 102,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 103,
      "t1": 120,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 128,
      "t1": 134,
      "arabic": "فلا أقسم بمواقع النجوم"
    },
    {
      "t0": 135,
      "t1": 141,
      "arabic": "وإنه لقسم لو تعلمون عظيم"
    },
    {
      "t0": 142,
      "t1": 147,
      "arabic": "إنه لقرآن كريم"
    },
    {
      "t0": 148,
      "t1": 151,
      "arabic": "في كتاب مكنون"
    },
    {
      "t0": 152,
      "t1": 159,
      "arabic": "لا يمسه إلا المطهرون"
    },
    {
      "t0": 160,
      "t1": 167,
      "arabic": "تنزيل من رب العالمين"
    },
    {
      "t0": 168,
      "t1": 174,
      "arabic": "أفبهذا الحديث أنتم مدهنون"
    },
    {
      "t0": 174,
      "t1": 182,
      "arabic": "وتجعلون رزقكم أنكم تكذبون"
    },
    {
      "t0": 183,
      "t1": 189,
      "arabic": "فلولا إذا بلغت الحلقوم"
    },
    {
      "t0": 190,
      "t1": 196,
      "arabic": "وأنتم حينئذ تنظرون"
    },
    {
      "t0": 197,
      "t1": 205,
      "arabic": "ونحن أقرب إليه منكم ولكن لا تبصرون"
    },
    {
      "t0": 206,
      "t1": 211,
      "arabic": "فلولا إن كنتم غير مدينين"
    },
    {
      "t0": 212,
      "t1": 223,
      "arabic": "ترجعونها إن كنتم صادقين"
    },
    {
      "t0": 224,
      "t1": 230,
      "arabic": "فأما إن كان من المقربين"
    },
    {
      "t0": 231,
      "t1": 237,
      "arabic": "فروح وريحان وجنة نعيم"
    },
    {
      "t0": 238,
      "t1": 244,
      "arabic": "وأما إن كان من أصحاب اليمين"
    },
    {
      "t0": 245,
      "t1": 252,
      "arabic": "فسلام لك من أصحاب اليمين"
    },
    {
      "t0": 253,
      "t1": 261,
      "arabic": "وأما إن كان من المكذبين الضالين"
    },
    {
      "t0": 262,
      "t1": 265,
      "arabic": "فنزل من حميم"
    },
    {
      "t0": 266,
      "t1": 269,
      "arabic": "وتصلية جحيم"
    },
    {
      "t0": 270,
      "t1": 276,
      "arabic": "إن هذا لهو حق اليقين"
    },
    {
      "t0": 277,
      "t1": 286,
      "arabic": "فسبح باسم ربك العظيم"
    },
