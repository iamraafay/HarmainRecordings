      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 135,
      "t1": 145,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 150,
      "t1": 167,
      "arabic": "الذين يبلغون رسالات الله ويخشونه ولا يخشون أحدا إلا الله وكفى بالله حسيبا"
    },
    {
      "t0": 168,
      "t1": 193,
      "arabic": "ما كان محمد أبا أحد من رجالكم ولكن رسول الله وخاتم النبيين وكان الله بكل شيء عليما"
    },
    {
      "t0": 194,
      "t1": 204,
      "arabic": "يا أيها الذين آمنوا اذكروا الله ذكرا كثيرا"
    },
    {
      "t0": 204,
      "t1": 210,
      "arabic": "وسبحوه بكرة وأصيلا"
    },
    {
      "t0": 211,
      "t1": 231,
      "arabic": "هو الذي يصلي عليكم وملائكته ليخرجكم من الظلمات إلى النور وكان بالمؤمنين رحيما"
    },
    {
      "t0": 232,
      "t1": 245,
      "arabic": "تحيتهم يوم يلقونه سلام وأعد لهم أجرا كريما"
