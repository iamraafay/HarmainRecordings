    },
    {
      "t0": 138,
      "t1": 140,
      "arabic": "فأثرن به نقعا"
    },
    {
      "t0": 141,
      "t1": 144,
      "arabic": "فوسطن به جمعا"
    },
    {
      "t0": 145,
      "t1": 151,
      "arabic": "إن الإنسان لربه لكنود"
    },
    {
      "t0": 152,
      "t1": 157,
      "arabic": "وإنه على ذلك لشهيد"
    },
    {
      "t0": 158,
      "t1": 163,
      "arabic": "وإنه لحب الخير لشديد"
    },
    {
      "t0": 164,
      "t1": 170,
      "arabic": "أفلا يعلم إذا بعثر ما في القبور"
    },
    {
      "t0": 171,
      "t1": 176,
      "arabic": "وحصل ما في الصدور"
    },
    {
      "t0": 177,
      "t1": 185,
      "arabic": "إن ربهم بهم يومئذ لخبير"
    },
    {
