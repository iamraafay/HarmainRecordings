    },
    {
      "t0": 91,
      "t1": 98,
      "arabic": "اهدنا الصراط المستقيم صراط الذين أنعمت عليهم"
    },
    {
      "t0": 98,
      "t1": 108,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 114,
      "t1": 118,
      "arabic": "والضحى والليل إذا سجى"
    },
    {
      "t0": 119,
      "t1": 123,
      "arabic": "ما ودعك ربك وما قلى"
