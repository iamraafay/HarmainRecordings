  "segments": [
    {
      "t0": 80,
      "t1": 83,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 84,
      "t1": 88,
      "arabic": "الرحمن الرحيم مالك يوم الدين"
    },
    {
      "t0": 88,
      "t1": 93,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 94,
      "t1": 98,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 98,
      "t1": 106,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 119,
      "t1": 128,
      "arabic": "فإذا جاءت الطامة الكبرى"
    },
    {
      "t0": 129,
      "t1": 135,
      "arabic": "يوم يتذكر الإنسان ما سعى"
    },
    {
      "t0": 135,
      "t1": 140,
      "arabic": "وبرزت الجحيم لمن يرى"
    },
    {
      "t0": 140,
      "t1": 149,
      "arabic": "فأما من طغى وآثر الحياة الدنيا"
    },
    {
      "t0": 149,
      "t1": 154,
      "arabic": "فإن الجحيم هي المأوى"
    },
    {
      "t0": 154,
      "t1": 164,
      "arabic": "وأما من خاف مقام ربه ونهى النفس عن الهوى"
    },
    {
      "t0": 164,
      "t1": 174,
      "arabic": "فإن الجنة هي المأوى"
    },
    {
      "t0": 175,
      "t1": 181,
      "arabic": "يسألونك عن الساعة أيان مرساها"
    },
    {
      "t0": 181,
      "t1": 188,
      "arabic": "فيم أنت من ذكراها"
    },
    {
      "t0": 188,
      "t1": 193,
      "arabic": "إلى ربك منتهاها"
    },
    {
      "t0": 194,
      "t1": 204,
      "arabic": "إنما أنت منذر من يخشاها"
    },
    {
      "t0": 204,
      "t1": 217,
      "arabic": "كأنهم يوم يرونها لم يلبثوا إلا عشية أو ضحاها"
    },
    {
      "t0": 287,
      "t1": 291,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 291,
      "t1": 296,
      "arabic": "الرحمن الرحيم مالك يوم الدين"
    },
    {
      "t0": 296,
      "t1": 301,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 301,
      "t1": 306,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 306,
      "t1": 321,
      "arabic": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 329,
      "t1": 335,
      "arabic": "إن الأبرار لفي نعيم"
    },
    {
      "t0": 335,
      "t1": 343,
      "arabic": "على الأرائك ينظرون"
    },
    {
      "t0": 343,
      "t1": 351,
      "arabic": "تعرف في وجوههم نضرة النعيم"
    },
    {
      "t0": 351,
      "t1": 359,
      "arabic": "يسقون من رحيق مختوم"
    },
    {
      "t0": 359,
      "t1": 366,
      "arabic": "ختامه مسك وفي ذلك فليتنافس المتنافسون"
    },
    {
      "t0": 367,
      "t1": 373,
      "arabic": "ومزاجه من تسنيم"
    },
    {
      "t0": 373,
      "t1": 381,
      "arabic": "عينا يشرب بها المقربون"
    }
