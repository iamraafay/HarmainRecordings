    },
    {
      "t0": 76,
      "t1": 89,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 95,
      "t1": 97,
      "arabic": "والضحى"
    },
    {
      "t0": 97,
