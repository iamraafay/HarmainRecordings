    },
    {
      "t0": 120,
      "t1": 126,
      "arabic": "ألم يجدك يتيما فآوى"
    },
    {
      "t0": 126,
      "t1": 134,
      "arabic": "ووجدك ضالا فهدى"
    },
    {
      "t0": 135,
      "t1": 142,
      "arabic": "ووجدك عائلا فأغنى"
    },
    {
      "t0": 143,
      "t1": 149,
      "arabic": "فأما اليتيم فلا تقهر"
    },
    {
      "t0": 149,
      "t1": 157,
      "arabic": "وأما السائل فلا تنهر"
    },
    {
      "t0": 157,
      "t1": 165,
      "arabic": "وأما بنعمة ربك فحدث"
