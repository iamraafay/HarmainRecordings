      "t1": 152,
      "arabic": "إِنْ هُوَ إِلَّا وَحْيٌ يُوحَى"
    },
    {
      "t0": 153,
      "t1": 157,
      "arabic": "عَلَّمَهُ شَدِيدُ الْقُوَى"
