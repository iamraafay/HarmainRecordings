    {
      "t0": 233,
      "t1": 242,
      "arabic": "أَفَرَأَيْتُمُ اللَّاتَ وَالْعُزَّى وَمَنَاةَ الثَّالِثَةَ الْأُخْرَى"
    },
    {
      "t0": 243,
      "t1": 247,
      "arabic": "أَلَكُمُ الذَّكَرُ وَلَهُ الْأُنْثَى"
