    {
      "t0": 208,
      "t1": 213,
      "arabic": "عِنْدَهَا جَنَّةُ الْمَأْوَى"
    },
    {
      "t0": 214,
      "t1": 219,
      "arabic": "إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى"
    },
    {
      "t0": 220,
      "t1": 224,
      "arabic": "مَا زَاغَ الْبَصَرُ وَمَا طَغَى"
