  "segments": [
    {
      "t0": 59,
      "t1": 63,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 63,
      "t1": 67,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 67,
      "t1": 73,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 74,
      "t1": 81,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 81,
      "t1": 86,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 86,
      "t1": 92,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 92,
      "t1": 105,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 111,
      "t1": 118,
      "arabic": "إذا السماء انفطرت"
    },
    {
      "t0": 118,
      "t1": 124,
      "arabic": "وإذا الكواكب انتثرت"
    },
    {
      "t0": 124,
      "t1": 129,
      "arabic": "وإذا البحار فجرت"
    },
    {
      "t0": 129,
      "t1": 133,
      "arabic": "وإذا القبور بعثرت"
    },
    {
      "t0": 133,
      "t1": 141,
      "arabic": "علمت نفس ما قدمت وأخرت"
    },
    {
      "t0": 142,
      "t1": 152,
      "arabic": "يا أيها الإنسان ما غرك بربك الكريم"
    },
    {
      "t0": 153,
      "t1": 159,
      "arabic": "الذي خلقك فسواك فعدلك"
    },
    {
      "t0": 159,
      "t1": 171,
      "arabic": "في أي صورة ما شاء ركبك"
    },
    {
      "t0": 171,
      "t1": 177,
      "arabic": "كلا بل تكذبون بالدين"
    },
    {
      "t0": 177,
      "t1": 185,
      "arabic": "وإن عليكم لحافظين"
    },
    {
      "t0": 185,
      "t1": 195,
      "arabic": "كراما كاتبين يعلمون ما تفعلون"
    },
    {
      "t0": 195,
      "t1": 201,
      "arabic": "إن الأبرار لفي نعيم"
    },
    {
      "t0": 201,
      "t1": 208,
      "arabic": "وإن الفجار لفي جحيم"
    },
    {
      "t0": 208,
      "t1": 214,
      "arabic": "يصلونها يوم الدين"
    },
    {
      "t0": 214,
      "t1": 223,
      "arabic": "وما هم عنها بغائبين"
    },
    {
      "t0": 223,
      "t1": 231,
      "arabic": "وما أدراك ما يوم الدين"
    },
    {
      "t0": 231,
      "t1": 240,
      "arabic": "ثم ما أدراك ما يوم الدين"
    },
    {
      "t0": 240,
      "t1": 258,
      "arabic": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله"
    },
    {
      "t0": 327,
      "t1": 333,
      "arabic": "الحمد لله رب العالمين"
    },
    {
      "t0": 333,
      "t1": 337,
      "arabic": "الرحمن الرحيم"
    },
    {
      "t0": 337,
      "t1": 341,
      "arabic": "مالك يوم الدين"
    },
    {
      "t0": 341,
      "t1": 348,
      "arabic": "إياك نعبد وإياك نستعين"
    },
    {
      "t0": 348,
      "t1": 352,
      "arabic": "اهدنا الصراط المستقيم"
    },
    {
      "t0": 352,
      "t1": 358,
      "arabic": "صراط الذين أنعمت عليهم"
    },
    {
      "t0": 358,
      "t1": 372,
      "arabic": "غير المغضوب عليهم ولا الضالين"
    },
    {
      "t0": 381,
      "t1": 385,
      "arabic": "القارعة ما القارعة"
    },
    {
      "t0": 385,
      "t1": 391,
      "arabic": "وما أدراك ما القارعة"
    },
    {
      "t0": 391,
      "t1": 399,
      "arabic": "يوم يكون الناس كالفراش المبثوث"
    },
    {
      "t0": 400,
      "t1": 410,
      "arabic": "وتكون الجبال كالعهن المنفوش"
    },
    {
      "t0": 410,
      "t1": 422,
      "arabic": "فأما من ثقلت موازينه فهو في عيشة راضية"
    },
    {
      "t0": 422,
      "t1": 435,
      "arabic": "وأما من خفت موازينه فأمه هاوية"
    },
    {
      "t0": 435,
      "t1": 441,
      "arabic": "وما أدراك ما هية"
    },
    {
      "t0": 442,
      "t1": 447,
      "arabic": "نار حامية"
    }
  ],
