      "t1": 247,
      "arabic": "وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّا"
    },
    {
      "t0": 248,
      "t1": 257,
      "arabic": "كَلَّا إِذَا دُكَّتِ الْأَرْضُ دَكًّا دَكًّا"
