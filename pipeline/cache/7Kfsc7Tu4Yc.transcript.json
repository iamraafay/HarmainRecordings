      "t1": 155,
      "arabic": "وَفِرْعَوْنَ ذِي الْأَوْتَادِ"
    },
    {
      "t0": 155,
      "t1": 161,
      "arabic": "الَّذِينَ طَغَوْا فِي الْبِلَادِ"
