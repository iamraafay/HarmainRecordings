{
  "model": "gemini-3.6-flash",
  "segments": [
    {
      "t0": 69,
      "t1": 74,
      "arabic": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ"
    },
    {
      "t0": 75,
      "t1": 80,
      "arabic": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ مَٰلِكِ يَوۡمِ ٱلدِّينِ"
    },
    {
      "t0": 81,
      "t1": 87,
      "arabic": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"
    },
    {
      "t0": 87,
      "t1": 95,
      "arabic": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ"
    },
    {
      "t0": 96,
      "t1": 106,
      "arabic": "غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ"
    },
    {
      "t0": 112,
      "t1": 115,
      "arabic": "يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ"
    },
    {
      "t0": 116,
      "t1": 118,
      "arabic": "قُمۡ فَأَنذِرۡ"
    },
    {
      "t0": 119,
      "t1": 121,
      "arabic": "وَرَبَّكَ فَكَبِّرۡ"
    },
    {
      "t0": 122,
      "t1": 124,
      "arabic": "وَثِيَابَكَ فَطَهِّرۡ"
    },
    {
      "t0": 125,
      "t1": 127,
      "arabic": "وَٱلرُّجۡزَ فَٱهۡجُرۡ"
    },
    {
      "t0": 128,
      "t1": 132,
      "arabic": "وَلَا تَمۡنُن تَسۡتَكۡثِرُ"
    },
    {
      "t0": 133,
      "t1": 136,
      "arabic": "وَلِرَبِّكَ فَٱصۡبِرۡ"
    },
    {
      "t0": 136,
      "t1": 143,
      "arabic": "فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ"
    },
    {
      "t0": 144,
      "t1": 150,
      "arabic": "فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ"
    },
    {
      "t0": 151,
      "t1": 156,
      "arabic": "عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ"
    },
    {
      "t0": 157,
      "t1": 162,
      "arabic": "ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا"
    },
    {
      "t0": 163,
      "t1": 169,
      "arabic": "وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا"
    },
    {
      "t0": 169,
      "t1": 172,
      "arabic": "وَبَنِينَ شُهُودٗا"
    },
    {
      "t0": 173,
      "t1": 177,
      "arabic": "وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا"
    },
    {
      "t0": 178,
      "t1": 183,
      "arabic": "ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ"
    },
    {
      "t0": 184,
      "t1": 191,
      "arabic": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا"
    },
    {
      "t0": 191,
      "t1": 195,
      "arabic": "سَأُرۡهِقُهُۥ صَعُودًا"
    },
    {
      "t0": 196,
      "t1": 201,
      "arabic": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ"
    },
    {
      "t0": 202,
      "t1": 205,
      "arabic": "فَقُتِلَ كَيۡفَ قَدَّرَ"
    },
    {
      "t0": 205,
      "t1": 209,
      "arabic": "ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ"
    },
    {
      "t0": 210,
      "t1": 214,
      "arabic": "ثُمَّ نَظَرَ"
    },
    {
      "t0": 215,
      "t1": 219,
      "arabic": "ثُمَّ عَبَسَ وَبَسَرَ"
    },
    {
      "t0": 220,
      "t1": 224,
      "arabic": "ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ"
    },
    {
      "t0": 225,
      "t1": 230,
      "arabic": "فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٌ يُؤۡثَرُ"
    },
    {
      "t0": 231,
      "t1": 236,
      "arabic": "إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ"
    },
    {
      "t0": 236,
      "t1": 239,
      "arabic": "سَأُصۡلِيهِ سَقَرَي"
    },
    {
      "t0": 240,
      "t1": 243,
      "arabic": "وَمَآ أَدۡرَىٰكَ مَا سَقَرُ"
    },
    {
      "t0": 244,
      "t1": 247,
      "arabic": "لَا تُبۡقِي وَلَا تَذَرُ"
    },
    {
      "t0": 248,
      "t1": 250,
      "arabic": "لَوَّاحَةٌ لِّلۡبَشَرِ"
    },
    {
      "t0": 251,
      "t1": 255,
      "arabic": "عَلَيۡهَا تِسۡعَةَ عَشَرَ"
    },
    {
      "t0": 256,
      "t1": 265,
      "arabic": "وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةً"
    },
    {
      "t0": 266,
      "t1": 284,
      "arabic": "وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةً لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنٗا"
    },
    {
      "t0": 285,
      "t1": 307,
      "arabic": "وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٌ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗا"
    },
    {
      "t0": 308,
      "t1": 319,
      "arabic": "كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُ"
    },
    {
      "t0": 320,
      "t1": 327,
      "arabic": "وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ"
    },
    {
      "t0": 328,
      "t1": 332,
      "arabic": "وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ"
    },
    {
      "t0": 333,
      "t1": 336,
      "arabic": "كَلَّا وَٱلۡقَمَرِ"
    },
    {
      "t0": 336,
      "t1": 339,
      "arabic": "وَٱلَّيۡلِ إِذۡ أَدۡبَرَ"
    },
    {
      "t0": 339,
      "t1": 343,
      "arabic": "وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ"
    },
    {
      "t0": 343,
      "t1": 347,
      "arabic": "إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ"
    },
    {
      "t0": 348,
      "t1": 350,
      "arabic": "نَذِيرٗا لِّلۡبَشَرِ"
    },
    {
      "t0": 351,
      "t1": 363,
      "arabic": "لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ"
    },
    {
      "t0": 430,
      "t1": 436,
      "arabic": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"
    },
    {
      "t0": 437,
      "t1": 445,
      "arabic": "مَٰلِكِ يَوۡمِ ٱلدِّينِ إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"
    },
    {
      "t0": 445,
      "t1": 453,
      "arabic": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ"
    },
    {
      "t0": 454,
      "t1": 465,
      "arabic": "غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ"
    },
    {
      "t0": 472,
      "t1": 478,
      "arabic": "كُلُّ نَفۡسٍۭ بِمَا كَسَبَتۡ رَهِينَةٌ"
    },
    {
      "t0": 479,
      "t1": 483,
      "arabic": "إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ"
    },
    {
      "t0": 483,
      "t1": 491,
      "arabic": "فِي جَنَّٰتٖ يَتَسَآءَلُونَ"
    },
    {
      "t0": 492,
      "t1": 495,
      "arabic": "عَنِ ٱلۡمُجۡرِمِينَ"
    },
    {
      "t0": 496,
      "t1": 499,
      "arabic": "مَا سَلَكَكُمۡ فِي سَقَرَ"
    },
    {
      "t0": 499,
      "t1": 504,
      "arabic": "قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ"
    },
    {
      "t0": 505,
      "t1": 510,
      "arabic": "وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ"
    },
    {
      "t0": 510,
      "t1": 519,
      "arabic": "وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ"
    },
    {
      "t0": 520,
      "t1": 527,
      "arabic": "وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ"
    },
    {
      "t0": 528,
      "t1": 533,
      "arabic": "حَتَّىٰ أَتَىٰنَا ٱلۡيَقِينُ"
    },
    {
      "t0": 534,
      "t1": 541,
      "arabic": "فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ"
    },
    {
      "t0": 541,
      "t1": 547,
      "arabic": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ"
    },
    {
      "t0": 548,
      "t1": 554,
      "arabic": "كَأَنَّهُمۡ حُمُرٌ مُّسۡتَنفِرَةٌ"
    },
    {
      "t0": 555,
      "t1": 558,
      "arabic": "فَرَّتۡ مِن قَسۡوَرَةِۭ"
    },
    {
      "t0": 559,
      "t1": 569,
      "arabic": "بَلۡ يُرِيدُ كُلُّ ٱمۡرِىٍٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةً"
    },
    {
      "t0": 570,
      "t1": 575,
      "arabic": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ"
    },
    {
      "t0": 576,
      "t1": 580,
      "arabic": "كَلَّآ إِنَّهُۥ تَذۡكِرَةٌ"
    },
    {
      "t0": 581,
      "t1": 586,
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "t0": 586,
      "t1": 587,
      "arabic": "فَمَن شَاءَ ذَكَرَهُ"
    },
    {
      "t0": 587,
      "t1": 599,
      "arabic": "وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ"
    },
    {
      "t0": 599,
      "t1": 606,
      "arabic": "وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ"
    }
  ],
  "windows": 2
}
